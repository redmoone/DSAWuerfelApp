@using DsaWuerfelApp.Client.Pages
<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteAccessView RouteData="@routeData"/>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <NotFound/>
        </LayoutView>
    </NotFound>
</Router>
