@inject ActiveHeroState ActiveHeroState
@using DsaWuerfelApp.Client.Services
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DsaWuerfelApp</a>
        @if (!string.IsNullOrWhiteSpace(ActiveHeroName))
        {
            <NavLink class="active-hero-nav" href="helden-verwaltung">@ActiveHeroName</NavLink>
        }
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="wuerfel">
                <span class="bi bi-dice-5-fill-nav-menu" aria-hidden="true"></span> Würfeln
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="kampf">
                <span class="bi bi-shield-fill-nav-menu" aria-hidden="true"></span> Kampf
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="helden-verwaltung">
                <span class="bi bi-person-lines-fill" aria-hidden="true"></span> Heldenverwaltung
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private string? ActiveHeroName => ActiveHeroState.CurrentHero?.Name;

    protected override async Task OnInitializedAsync()
    {
        ActiveHeroState.Changed += HandleActiveHeroChanged;
        await ActiveHeroState.EnsureLoadedAsync();
    }

    public void Dispose()
    {
        ActiveHeroState.Changed -= HandleActiveHeroChanged;
    }

    private void HandleActiveHeroChanged()
    {
        InvokeAsync(StateHasChanged);
    }

}
