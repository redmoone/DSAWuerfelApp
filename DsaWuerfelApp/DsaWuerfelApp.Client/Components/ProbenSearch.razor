<div class="search-wrapper">
    <img src="icons/search.svg" class="search-icon" alt=""/>
    <input type="text"
           class="search-input"
           placeholder="@Placeholder"
           @bind="SearchTerm"
           @bind:event="oninput"
           @onfocus="() => _isDropdownOpen = true"
           @onblur="HandleBlur"/>

    @if (_isDropdownOpen && FilteredProben.Any())
    {
        <div class="search-dropdown">
            @foreach (var probe in FilteredProben)
            {
                <div class="dropdown-item" @onclick="() => SelectProbe(probe)">
                    @probe
                </div>
            }
        </div>
    }
</div>
