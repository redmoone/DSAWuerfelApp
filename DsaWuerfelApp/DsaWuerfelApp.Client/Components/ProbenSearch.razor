<div class="search-wrapper">
    <img src="icons/search.svg" class="search-icon" alt=""/>
    <input type="text"
           class="search-input"
           placeholder="@Placeholder"
           @bind="SearchTerm"
           @bind:event="oninput"
           @onclick="HandleInputClick"
           @onfocus="() => _isDropdownOpen = true"
           @onblur="HandleBlur"/>

    @if (_isDropdownOpen && FilteredProben.Any())
    {
        <div class="search-dropdown">
            @foreach (var probe in FilteredProben)
            {
                <div class="dropdown-item @(probe.IsSelectable ? string.Empty : "inactive")"
                     @onclick="() => HandleEntryClick(probe)">
                    <div class="dropdown-item-content">
                        <span class="dropdown-item-label">@probe.DisplayLabel</span>

                        @if (probe.Alternatives.Length > 0)
                        {
                            <div class="dropdown-item-alternatives">
                                @foreach (var alternative in probe.Alternatives)
                                {
                                    <button type="button"
                                            class="dropdown-alternative"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => SelectProbe(alternative.Value)">
                                        @alternative.Label
                                    </button>
                                }
                            </div>
                        }
                        else if (!probe.IsSelectable)
                        {
                            <span class="dropdown-item-note">Keine aktivierten Alternativen vorhanden.</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_isDropdownOpen && !UseFallbackCatalog && !FilteredProben.Any())
    {
        <div class="search-dropdown">
            <div class="dropdown-item inactive">
                <div class="dropdown-item-content">
                    <span class="dropdown-item-note">Keine gemeinsamen Proben für diese Auswahl gefunden.</span>
                </div>
            </div>
        </div>
    }
</div>
