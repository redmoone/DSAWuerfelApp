@using DsaWuerfelApp.Shared
<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6">Zauber / Liturgie</MudText>

    <MudGrid>
        <MudItem xs="4">
            <MudNumericField @bind-Value="Attr1" Label="MU/KL/IN" Variant="Variant.Outlined"/>
        </MudItem>
        <MudItem xs="4">
            <MudNumericField @bind-Value="Attr2" Label="CH/FF/GE" Variant="Variant.Outlined"/>
        </MudItem>
        <MudItem xs="4">
            <MudNumericField @bind-Value="Attr3" Label="KK/KO" Variant="Variant.Outlined"/>
        </MudItem>

        <MudItem xs="6">
            <MudNumericField @bind-Value="SkillValue" Label="Fertigkeitswert (FW)" Variant="Variant.Outlined"/>
        </MudItem>
        <MudItem xs="6">
            <MudNumericField @bind-Value="Modifier" Label="Modifikator" Variant="Variant.Outlined"/>
        </MudItem>

        <MudItem xs="12" Class="d-flex justify-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Roll">Zauber wirken</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public EventCallback<(List<DiceGroup> Dice, int Modifier, string Label)> OnRollRequest { get; set; }

    private int Attr1 { get; set; } = 12;
    private int Attr2 { get; set; } = 12;
    private int Attr3 { get; set; } = 12;
    private int SkillValue { get; set; } = 5;
    private int Modifier { get; set; } = 0;

    private async Task Roll()
    {
        // Logik für Magie: 3x W20 in verschiedenen Farben
        var dice = new List<DiceGroup>
        {
            new DiceGroup { DiceType = "d20", Count = 1, Color = "#FFA500" }, // Mut (Orange)
            new DiceGroup { DiceType = "d20", Count = 1, Color = "#800080" }, // Klugheit (Lila)
            new DiceGroup { DiceType = "d20", Count = 1, Color = "#008000" } // Intuition (Grün)
        };

        // Hier könnte man den FW (SkillValue) noch mitsenden, wenn das Backend das braucht.
        // Für dieses Beispiel packen wir es einfach in den Modifier oder senden es separat, 
        // je nachdem wie deine RollRequest Klasse aussieht.

        // Hinweis: In einer echten App würdest du wahrscheinlich eine komplexere Datenstruktur übergeben,
        // die auch die Attribute für den Qualitäts-Check enthält.
        await OnRollRequest.InvokeAsync((dice, Modifier, $"Zauberprobe (FW {SkillValue})"));
    }

}