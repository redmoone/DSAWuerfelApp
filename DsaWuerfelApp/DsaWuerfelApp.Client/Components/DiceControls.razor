<div class="d-flex justify-center flex-wrap gap-7 align-center">
    @foreach (var s in AvailableSides)
    {
        <button type="button" class="die-selector" @onclick="() => OnAddDie.InvokeAsync(s)">
            <div class="die-shape @GetShapeClass(s)">
                <span class="die-text">@s</span>
            </div>
        </button>
    }
</div>
