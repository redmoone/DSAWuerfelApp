<MudDivider Class="my-4" />

<div class="d-flex justify-center flex-wrap gap-6 align-center">
    @foreach (var s in AvailableSides)
    {
        <div class="die-selector" @onclick="() => OnAddDie.InvokeAsync(s)">
            <div class="die-shape @GetShapeClass(s)">
                <span class="die-text">@s</span>
            </div>
        </div>
    }
</div>

<div class="d-flex justify-center align-center gap-4 mt-6">
    <div class="d-flex align-center pa-1 modifier-container">
        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="DecreaseModifier" Style="color: var(--dsa-gold);" />
        
        <input type="number" value="@Modifier" @onchange="OnModifierChanged" class="modifier-input" />
        
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="IncreaseModifier" Style="color: var(--dsa-gold);" />
    </div>

    <button class="dsa-btn-icon @(IsHiddenRoll ? "active" : "")" @onclick="ToggleHiddenRoll" title="@(IsHiddenRoll ? "Verdeckter Wurf" : "Öffentlicher Wurf")">
        <img src="icons/eye-closed.svg" class="btn-icon" alt="" />
    </button>

    <button class="dsa-btn" @onclick="() => OnRoll.InvokeAsync()" disabled="@(!HasSelection)">
        Würfeln
    </button>

    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Filled" Size="Size.Medium"
                   OnClick="() => OnReset.InvokeAsync()" title="Tisch leeren" Class="rounded-circle"
                   Style="background-color: var(--pill-bg); color: var(--dsa-white); border: 3px solid var(--dsa-gold);" />
</div>

@code 
{
    [Parameter] public int[] AvailableSides { get; set; } = [];
    [Parameter] public int Modifier { get; set; }
    [Parameter] public bool HasSelection { get; set; }
    [Parameter] public bool IsHiddenRoll { get; set; }
    
    [Parameter] public EventCallback<int> OnAddDie { get; set; }
    [Parameter] public EventCallback<int> ModifierChanged { get; set; }
    [Parameter] public EventCallback<bool> IsHiddenRollChanged { get; set; }
    [Parameter] public EventCallback OnRoll { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    private Task DecreaseModifier() => ModifierChanged.InvokeAsync(Modifier - 1);
    
    private Task IncreaseModifier() => ModifierChanged.InvokeAsync(Modifier + 1);
    
    private Task ToggleHiddenRoll()
    {
        IsHiddenRoll = !IsHiddenRoll;
        return IsHiddenRollChanged.InvokeAsync(IsHiddenRoll);
    }

    private Task OnModifierChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            return ModifierChanged.InvokeAsync(val);
        }
        
        return Task.CompletedTask;
    }

    private static string GetShapeClass(int sides) => "shape-d" + sides;
}