<div class="results-bar">
    @if (ShowTitle)
    {
        <h3 class="results-title">Wurf abschließen</h3>
    }

    <div class="global-actions-bar">
        @if (ShowRollText)
        {
            <div class="roll-text-row">
                <TextPill Value="@RollText"
                          ValueChanged="@RollTextChanged"
                          Placeholder="Würfeltext"
                          Label="TEXT"
                          Disabled="@IsBusy" />
            </div>
        }

        <div class="left-actions">
            <ModifierPill Value="@Modifier"
                          DisplayValue="@CurrentDisplayModifier"
                          AllowDirectInput="@AllowDirectModifierInput"
                          ValueChanged="ModifierChanged" />

            @if (ShowHiddenRollHint)
            {
                <span class="hidden-roll-hint"
                      role="img"
                      tabindex="0"
                      aria-label="Verdeckte Würfe sind derzeit nicht verfügbar."
                      data-tooltip="Verdeckte Würfe sind derzeit nicht verfügbar.">
                    <UiButton Variant="icon"
                              Disabled="true"
                              aria-hidden="true"
                              tabindex="-1">
                        <img src="icons/eye-closed.svg" class="btn-icon" alt="" aria-hidden="true" />
                    </UiButton>
                </span>
            }

            @if (string.IsNullOrWhiteSpace(ResetButtonText))
            {
                <UiButton Variant="icon"
                          Class="reset-roll-button"
                          OnClick="ResetRequested"
                          Disabled="@IsBusy"
                          title="Tisch leeren"
                          aria-label="Tisch leeren">
                    <span aria-hidden="true">↻</span>
                </UiButton>
            }
            else
            {
                <UiButton Size="compact"
                          Disabled="@IsBusy"
                          OnClick="ResetRequested">
                    @ResetButtonText
                </UiButton>
            }

            <div class="right-actions">
                <UiButton Variant="dice"
                          title="@($"{RollButtonText} ausführen")"
                          aria-label="@EffectiveRollButtonAriaLabel"
                          OnClick="RollRequested"
                          Disabled="@(!CanRoll || IsBusy)">
                    @RollButtonText
                </UiButton>
            </div>
        </div>
    </div>
</div>
