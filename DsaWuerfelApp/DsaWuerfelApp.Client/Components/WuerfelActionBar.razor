<div class="results-bar">
    <h3 class="results-title">Ergebnisse und Würfeln</h3>

    <div class="global-actions-bar">
        <div class="left-actions">
            <TextPill Value="@RollText"
                      ValueChanged="@RollTextChanged"
                      Placeholder="Würfeltext"
                      Label="TEXT"
                      Disabled="@IsBusy"/>

            <ModifierPill Value="@Modifier"
                          DisplayValue="@CurrentDisplayModifier"
                          ValueChanged="ModifierChanged"/>

            <span class="hidden-roll-hint"
                  role="img"
                  tabindex="0"
                  aria-label="Verdeckte Würfe sind derzeit nicht verfügbar."
                  data-tooltip="Verdeckte Würfe sind derzeit nicht verfügbar.">
                <button class="dsa-btn-icon"
                        disabled="true"
                        aria-hidden="true"
                        tabindex="-1">
                    <img src="icons/eye-closed.svg" class="btn-icon" alt="" aria-hidden="true"/>
                </button>
            </span>

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Variant="Variant.Filled"
                           OnClick="ResetRequested"
                           Disabled="@IsBusy"
                           title="Tisch leeren"
                           Class="rounded-circle reset-roll-button"
                           Style="width: 48px; height: 48px; background-color: var(--pill-bg); color: var(--dsa-white); border: 2px solid var(--dsa-gold);"/>
        </div>

        <div class="right-actions">
            <button class="dsa-btn" @onclick="RollRequested" disabled="@(!CanRoll || IsBusy)">
                Würfeln
            </button>
        </div>
    </div>
</div>
