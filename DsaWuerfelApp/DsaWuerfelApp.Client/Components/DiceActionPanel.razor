<div class="dice-action-panel">
    <div class="left-controls">
        @ResultPillContent

        <ModifierPill Modifier="Modifier" ModifierChanged="ModifierChanged"/>

        <UiButton Variant="icon" Active="@IsHiddenRoll" OnClick="ToggleHiddenRoll">
            <img src="icons/eye-closed.svg" class="btn-icon" alt=""/>
        </UiButton>
    </div>

    <div class="right-controls">
        <UiButton Variant="dice" OnClick="() => OnRoll.InvokeAsync()" Disabled="@(!HasSelection)">
            Würfeln
        </UiButton>
    </div>
</div>
