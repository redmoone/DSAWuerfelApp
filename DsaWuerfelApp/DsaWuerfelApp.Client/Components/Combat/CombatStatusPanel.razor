@using DsaWuerfelApp.Shared
@using DsaWuerfelApp.Client.Services

<section class="hero-status-bar combat-status-panel" aria-labelledby="combat-status-title">
    <div class="hero-status-topline">
        <div class="hero-status-identity">
            <p class="combat-kicker">Heldenstatus</p>
            <h2 id="combat-status-title">@HeroName</h2>
            <span>@(string.IsNullOrWhiteSpace(SessionName) ? "Solo" : $"Session: {SessionName}")</span>
        </div>

        <div class="hero-status-actions">
            <span class="hero-status-state">@(IsLoading ? "Profil wird geladen" : Profile is null ? "Profil fehlt" : IsCombatStarted ? "Zustand erfasst" : "Zustand offen")</span>
            @if (!IsCombatStarted && CanStartCombat && Profile is not null)
            {
                <div class="hero-status-initialize-actions">
                    <UiButton Variant="primary" Size="compact" Disabled="@IsMutationBusy" OnClick="StartCombatRequested">
                        Mit Maximalwerten beginnen
                    </UiButton>
                    <UiButton Size="compact" Disabled="@IsMutationBusy" OnClick="HandleCaptureRequested">
                        Aktuelle Werte erfassen
                    </UiButton>
                </div>
            }
            @if (ShowUndo && CanUndo)
            {
                <UiButton Size="compact" Disabled="@IsMutationBusy" OnClick="UndoRequested">Rückgängig</UiButton>
            }
        </div>
    </div>

    @if (IsLoading)
    {
        <p class="hero-status-message">Die Werte werden aus dem gespeicherten Heldenimport gelesen.</p>
    }
    else if (Profile is null)
    {
        <p class="hero-status-message">@(string.IsNullOrWhiteSpace(ErrorMessage) ? "Kein Kampfprofil verfügbar." : ErrorMessage)</p>
    }
    else
    {
        <div class="hero-status-resources" aria-label="Ressourcen und Kampfstatus">
            @if (ShouldShowResource(CombatResourceKind.LeP, Profile.Resources.LeP))
            {
                <UiButton Variant="resource"
                          Class="ui-resource-pill ui-resource-pill--lep"
                          OnClick="() => ResourceEditRequested.InvokeAsync(CombatResourceKind.LeP)"
                          Disabled="@IsMutationBusy"
                          aria-label="LeP bearbeiten">
                    <span class="ui-pill-edge-label">LeP</span>
                    <span class="ui-resource-value">@FormatResource(CurrentLeP, Profile.Resources.LeP)</span>
                    @if (CurrentLeP.HasValue)
                    {
                        <span class="ui-resource-track" aria-hidden="true"><span style="width:@GetBarWidth(CurrentLeP, Profile.Resources.LeP)"></span></span>
                    }
                </UiButton>
            }
            @if (ShouldShowResource(CombatResourceKind.AuP, Profile.Resources.AuP))
            {
                <UiButton Variant="resource"
                          Class="ui-resource-pill"
                          OnClick="() => ResourceEditRequested.InvokeAsync(CombatResourceKind.AuP)"
                          Disabled="@IsMutationBusy"
                          aria-label="AuP bearbeiten">
                    <span class="ui-pill-edge-label">AuP</span>
                    <span class="ui-resource-value">@FormatResource(CurrentAuP, Profile.Resources.AuP)</span>
                    @if (CurrentAuP.HasValue)
                    {
                        <span class="ui-resource-track" aria-hidden="true"><span style="width:@GetBarWidth(CurrentAuP, Profile.Resources.AuP)"></span></span>
                    }
                </UiButton>
            }
            @if (ShouldShowResource(CombatResourceKind.AeP, Profile.Resources.AeP))
            {
                <UiButton Variant="resource"
                          Class="ui-resource-pill"
                          OnClick="() => ResourceEditRequested.InvokeAsync(CombatResourceKind.AeP)"
                          Disabled="@IsMutationBusy"
                          aria-label="AeP bearbeiten">
                    <span class="ui-pill-edge-label">AeP</span>
                    <span class="ui-resource-value">@FormatResource(CurrentAeP, Profile.Resources.AeP)</span>
                    @if (CurrentAeP.HasValue)
                    {
                        <span class="ui-resource-track" aria-hidden="true"><span style="width:@GetBarWidth(CurrentAeP, Profile.Resources.AeP)"></span></span>
                    }
                </UiButton>
            }
            @if (ShouldShowResource(CombatResourceKind.KeP, Profile.Resources.KeP))
            {
                <UiButton Variant="resource"
                          Class="ui-resource-pill"
                          OnClick="() => ResourceEditRequested.InvokeAsync(CombatResourceKind.KeP)"
                          Disabled="@IsMutationBusy"
                          aria-label="KE bearbeiten">
                    <span class="ui-pill-edge-label">KE</span>
                    <span class="ui-resource-value">@FormatResource(CurrentKeP, Profile.Resources.KeP)</span>
                    @if (CurrentKeP.HasValue)
                    {
                        <span class="ui-resource-track" aria-hidden="true"><span style="width:@GetBarWidth(CurrentKeP, Profile.Resources.KeP)"></span></span>
                    }
                </UiButton>
            }

            <UiButton Variant="resource"
                      Class="ui-resource-pill"
                      OnClick="InitiativeRequested"
                      Disabled="@IsMutationBusy"
                      aria-label="Initiative bearbeiten">
                <span class="ui-pill-edge-label">INI</span>
                <span class="ui-resource-value">@FormatValue(CurrentInitiative)</span>
            </UiButton>

            <UiButton Variant="resource"
                      Class="ui-resource-pill"
                      OnClick="WoundsRequested"
                      Disabled="@IsMutationBusy"
                      aria-label="Wunden bearbeiten">
                <span class="ui-pill-edge-label">Wunden</span>
                <span class="ui-resource-value">@WoundSummary</span>
            </UiButton>
        </div>

        <div class="hero-status-footer">
            <span>WS @FormatValue(Profile.WoundThreshold)</span>
            @foreach (var effect in Effects.Take(3))
            {
                <span class="hero-effect-chip">@effect</span>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(PersistenceWarning))
    {
        <p class="combat-persistence-warning" role="status">@PersistenceWarning</p>
    }
</section>
