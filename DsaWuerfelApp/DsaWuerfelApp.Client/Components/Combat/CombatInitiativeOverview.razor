@using DsaWuerfelApp.Shared
@using DsaWuerfelApp.Client.Components

<aside class="combat-initiative-overview" aria-labelledby="combat-initiative-overview-title">
    <div class="combat-initiative-overview-heading">
        <div>
            <p class="combat-kicker">Zugstatus</p>
            <h2 id="combat-initiative-overview-title">Initiative</h2>
        </div>
        @if (IsSessionCombat && SessionCombat is { } headingSnapshot)
        {
            <span class="combat-initiative-overview-round">Runde @headingSnapshot.Round</span>
        }
    </div>

    @if (!IsSessionCombat)
    {
        <div class="combat-initiative-solo-summary">
            <span class="combat-initiative-turn-label">Solo · keine gemeinsame Zugfolge</span>
            <strong>@HeroName</strong>
            <span>@(CurrentInitiative.HasValue ? $"Laufend INI {CurrentInitiative}" : "Noch nicht gewürfelt")</span>
            <span>Basis @FormatInitiative(InitiativeBase)</span>
        </div>
    }
    else if (SessionCombat is not { } snapshot)
    {
        <p class="combat-initiative-overview-empty">Sessionstand wird geladen.</p>
    }
    else
    {
        <div class="combat-initiative-overview-meta">
            <strong>@(snapshot.IsStarted ? "Gemeinsame Zugfolge" : "Vorbereitung")</strong>
            <span>@(snapshot.IsStarted ? "Aktuelle Reihenfolge" : "Noch kein gemeinsamer Startwurf")</span>
        </div>

        @if (snapshot.ActiveExchange is { } exchange && CombatAttackExchangeRules.IsOpen(exchange))
        {
            <section class="combat-initiative-overview-exchange"
                     data-testid="combat-open-exchange"
                     aria-live="polite"
                     aria-label="Offener Angriffsaustausch">
                <div class="combat-initiative-overview-exchange-heading">
                    <div>
                        <span class="combat-field-label">Offener Austausch</span>
                        <strong>@GetExchangeStatusLabel(exchange.Status)</strong>
                    </div>
                    <span>Runde @exchange.Round</span>
                </div>
                <strong class="combat-initiative-overview-exchange-participants">
                    @GetParticipantName(snapshot, exchange.AttackerParticipantId)
                    <span aria-hidden="true">→</span>
                    @GetParticipantName(snapshot, exchange.TargetParticipantId)
                </strong>
                <span class="combat-initiative-overview-exchange-prompt">@GetExchangePrompt(snapshot, exchange)</span>
                @if (exchange.Status == CombatExchangeStatus.DefenseOpen && CanResolveActiveExchange)
                {
                    <div class="combat-initiative-overview-exchange-actions" data-testid="combat-exchange-defense">
                        @foreach (var defenseAction in exchange.AllowedDefenseActions)
                        {
                            <UiButton Variant="primary"
                                      Size="compact"
                                      OnClick="() => ExchangeActionRequested.InvokeAsync(defenseAction)">
                                @GetDefenseActionLabel(defenseAction)
                            </UiButton>
                        }
                    </div>
                }
            </section>
        }

        @if (Participants.Count == 0)
        {
            <p class="combat-initiative-overview-empty">Teilnehmer erscheinen nach ihrem ersten Initiativewurf.</p>
        }
        else
        {
            <div class="combat-initiative-overview-list" aria-label="Initiativereihenfolge">
                @foreach (var participant in Participants)
                {
                    var isCurrent = IsCurrentParticipant?.Invoke(participant) == true;
                    <article class="combat-initiative-overview-row @(isCurrent ? "current" : string.Empty) @GetTurnClass(participant)"
                             aria-current="@(isCurrent ? "step" : null)">
                        @if (IsTargetSelectable(participant))
                        {
                            <UiButton Variant="option"
                                      Size="compact"
                                      Class="@GetTargetClass(participant)"
                                      Active="@IsSelectedTarget(participant)"
                                      aria-pressed="@IsSelectedTarget(participant)"
                                      aria-label="@(IsSelectedTarget(participant) ? $"{participant.Name}, ausgewähltes Ziel" : $"{participant.Name} als Ziel auswählen")"
                                      OnClick="() => TargetSelected.InvokeAsync(participant.Id)">
                                <div class="combat-initiative-overview-topline">
                                    <span class="combat-initiative-turn-label">@GetTurnLabel(participant)</span>
                                    <span class="combat-initiative-value">@FormatInitiative(participant.CurrentInitiative)</span>
                                </div>
                                <strong>@participant.Name</strong>
                                <span>@GetAffiliation(participant)</span>
                                @if (IsSelectedTarget(participant))
                                {
                                    <small class="combat-initiative-overview-target-label">Ziel</small>
                                }
                                @if (!string.IsNullOrWhiteSpace(GetParticipantStatus(participant)))
                                {
                                    <small class="combat-initiative-overview-status">@GetParticipantStatus(participant)</small>
                                }
                                @if (participant.CurrentInitiative.HasValue && participant.InitiativeBase.HasValue && participant.CurrentInitiative != participant.InitiativeBase)
                                {
                                    <small>Basis @participant.InitiativeBase</small>
                                }
                            </UiButton>
                        }
                        else
                        {
                            <div class="combat-initiative-overview-person">
                                <div class="combat-initiative-overview-topline">
                                    <span class="combat-initiative-turn-label">@GetTurnLabel(participant)</span>
                                    <span class="combat-initiative-value">@FormatInitiative(participant.CurrentInitiative)</span>
                                </div>
                                <strong>@participant.Name</strong>
                                <span>@GetAffiliation(participant)</span>
                                @if (!string.IsNullOrWhiteSpace(GetParticipantStatus(participant)))
                                {
                                    <small class="combat-initiative-overview-status">@GetParticipantStatus(participant)</small>
                                }
                                @if (participant.CurrentInitiative.HasValue && participant.InitiativeBase.HasValue && participant.CurrentInitiative != participant.InitiativeBase)
                                {
                                    <small>Basis @participant.InitiativeBase</small>
                                }
                            </div>
                        }

                        <div class="combat-initiative-overview-flags">
                            <span class="combat-initiative-overview-flag @(participant.ActionAvailable ? "available" : string.Empty)">
                                @(participant.ActionAvailable ? "Aktion frei" : "Aktion verbraucht")
                            </span>
                            <span class="combat-initiative-overview-flag @(participant.ReactionAvailable ? "available" : string.Empty)">
                                @(participant.ReactionAvailable ? "Reaktion frei" : "Reaktion verbraucht")
                            </span>
                            @if (participant.CurrentInitiative is null && CanRollParticipantInitiative?.Invoke(participant) == true)
                            {
                                <UiButton Size="compact"
                                          Class="combat-initiative-overview-button"
                                          OnClick="() => RollInitiativeRequested.InvokeAsync(participant)">
                                    INI würfeln
                                </UiButton>
                            }
                            @if (CanRemoveOpponent?.Invoke(participant) == true)
                            {
                                <UiButton Size="compact"
                                          Class="combat-initiative-overview-button"
                                          OnClick="() => RemoveOpponentRequested.InvokeAsync(participant)">
                                    Entfernen
                                </UiButton>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(participant.Announcement))
                        {
                            <span class="combat-initiative-overview-announcement">Ansage: @participant.Announcement</span>
                        }

                    </article>
                }
            </div>
        }
    }
</aside>
