@using DsaWuerfelApp.Client.Components
@using DsaWuerfelApp.Shared

<section class="combat-hit-capture" role="dialog" aria-modal="false" aria-labelledby="combat-hit-capture-title">
    <div class="combat-panel-heading">
        <div>
            <p class="combat-kicker">Treffer erfassen</p>
            <h2 id="combat-hit-capture-title">Manuelle Erfassung</h2>
        </div>
        <span class="combat-muted">Keine Regelberechnung</span>
    </div>

    <p class="combat-hit-capture-intro">
        Übernimm einen am Tisch bereits ausgewerteten Treffer. LeP-Verlust und Wundstand werden nur am ausgewählten Heldenzustand gebucht.
    </p>

    <div class="combat-hit-capture-grid">
        <label class="combat-hit-field">
            <span class="combat-field-label">Getroffene Zone</span>
            <select class="ui-select" value="@SelectedZone" @onchange="HandleZoneChanged">
                @foreach (var zone in Enum.GetValues<CombatWoundZone>())
                {
                    <option value="@zone">@GetZoneLabel(zone)</option>
                }
            </select>
        </label>

        <div class="combat-hit-field">
            <TextPill Value="@LePLossText"
                      ValueChanged="LePLossTextChanged"
                      InputType="number"
                      Label="LeP"
                      Placeholder="0" />
        </div>

        <div class="combat-hit-field">
            <ModifierPill Value="@NewWounds"
                          ValueChanged="NewWoundsChanged"
                          LabelOverride="WUNDEN" />
        </div>

        <div class="combat-hit-field combat-hit-note-field">
            <TextPill Value="@Note"
                      ValueChanged="NoteChanged"
                      Label="NOTIZ"
                      Placeholder="Optional" />
        </div>
    </div>

    <div class="combat-hit-preview" aria-live="polite">
        <div>
            <span>Vorher LeP</span>
            <strong>@FormatValue(CurrentLeP)</strong>
        </div>
        <div>
            <span>Nachher LeP</span>
            <strong>@FormatValue(PreviewLeP)</strong>
        </div>
        <div>
            <span>Wunden</span>
            <strong>@(CurrentWounds.HasValue ? $"{CurrentWounds} → {NewWounds}" : $"nicht erfasst → {NewWounds}")</strong>
        </div>
    </div>

    <div class="combat-hit-actions">
        <UiButton Variant="primary" Disabled="@(!CanApply || IsBusy)" OnClick="ApplyRequested">
            Übernehmen
        </UiButton>
        <UiButton Disabled="@IsBusy" OnClick="CancelRequested">
            Abbrechen
        </UiButton>
    </div>
</section>
