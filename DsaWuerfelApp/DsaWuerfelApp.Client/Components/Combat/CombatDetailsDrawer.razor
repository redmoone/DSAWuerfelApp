@using Microsoft.AspNetCore.Components.Web
@using DsaWuerfelApp.Client.Components

@if (Open)
{
    <aside class="combat-details-drawer" role="dialog" aria-modal="true" aria-label="@Title" tabindex="-1" @onkeydown="HandleKeyDown">
        <div class="combat-details-drawer-header">
            <h2>@Title</h2>
            <UiButton Size="compact"
                      Class="combat-details-close"
                      @ref="_closeButton"
                      aria-label="Details schließen"
                      OnClick="CloseRequested">
                Schließen
            </UiButton>
        </div>
        <div class="combat-details-drawer-content">
            @ChildContent
        </div>
    </aside>
}
