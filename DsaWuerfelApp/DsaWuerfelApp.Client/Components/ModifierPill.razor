<div class="modifier-pill" aria-label="@LabelText">
    <span class="ui-pill-edge-label">@LabelText</span>

    <UiButton Variant="icon"
              Size="compact"
              Class="modifier-button"
              aria-label="@($"{LabelText} verringern")"
              OnClick="Decrease">−</UiButton>

    <div class="mod-center">
        @if (AllowDirectInput)
        {
            <input class="modifier-direct-input"
                   type="number"
                   inputmode="numeric"
                   value="@_draft"
                   aria-label="@LabelText"
                   @oninput="HandleInput"
                   @onkeydown="HandleKeyDown"
                   @onblur="CommitAsync" />
        }
        else
        {
            <div class="attribute-value">@FormattedValue</div>
        }
    </div>

    <UiButton Variant="icon"
              Size="compact"
              Class="modifier-button"
              aria-label="@($"{LabelText} erhöhen")"
              OnClick="Increase">+</UiButton>
</div>
