<div class="attribute-grid">
    <div title="Mut Probe auswählen (Links: + / Rechts: -)">
        <AttributePill ShortName="MU" Value='@GetValue("MU", 14)' IconPath="lion.svg" SelectionCount='@GetCount("MU")'
                       OnIncrease="HandleIncrease" OnDecrease="HandleDecrease"/>
    </div>
    <div title="Klugheit Probe auswählen (Links: + / Rechts: -)">
        <AttributePill ShortName="KL" Value='@GetValue("KL", 13)' IconPath="owl.svg" SelectionCount='@GetCount("KL")'
                       OnIncrease="HandleIncrease" OnDecrease="HandleDecrease"/>
    </div>
    <div title="Intuition Probe auswählen (Links: + / Rechts: -)">
        <AttributePill ShortName="IN" Value='@GetValue("IN", 15)' IconPath="eye.svg" SelectionCount='@GetCount("IN")'
                       OnIncrease="HandleIncrease" OnDecrease="HandleDecrease"/>
    </div>
    <div title="Charisma Probe auswählen (Links: + / Rechts: -)">
        <AttributePill ShortName="CH" Value='@GetValue("CH", 12)' IconPath="mask.svg" SelectionCount='@GetCount("CH")'
                       OnIncrease="HandleIncrease" OnDecrease="HandleDecrease"/>
    </div>
    <div title="Fingerfertigkeit Probe auswählen (Links: + / Rechts: -)">
        <AttributePill ShortName="FF" Value='@GetValue("FF", 15)' IconPath="hand.svg" SelectionCount='@GetCount("FF")'
                       OnIncrease="HandleIncrease" OnDecrease="HandleDecrease"/>
    </div>
    <div title="Gewandtheit Probe auswählen (Links: + / Rechts: -)">
        <AttributePill ShortName="GE" Value='@GetValue("GE", 15)' IconPath="cat.svg" SelectionCount='@GetCount("GE")'
                       OnIncrease="HandleIncrease" OnDecrease="HandleDecrease"/>
    </div>
    <div title="Konstitution Probe auswählen (Links: + / Rechts: -)">
        <AttributePill ShortName="KO" Value='@GetValue("KO", 14)' IconPath="shield.svg" SelectionCount='@GetCount("KO")'
                       OnIncrease="HandleIncrease" OnDecrease="HandleDecrease"/>
    </div>
    <div title="Körperkraft Probe auswählen (Links: + / Rechts: -)">
        <AttributePill ShortName="KK" Value='@GetValue("KK", 13)' IconPath="muscle.svg" SelectionCount='@GetCount("KK")'
                       OnIncrease="HandleIncrease" OnDecrease="HandleDecrease"/>
    </div>
</div>

<div class="attribute-selection-chips" aria-label="Ausgewählte Eigenschaften">
    @if (SelectedAttributes.Count == 0)
    {
        <span class="attribute-selection-placeholder">Eigenschaften auswählen</span>
    }
    else
    {
        @for (var index = 0; index < SelectedAttributes.Count; index++)
        {
            var selectedIndex = index;
            var attribute = SelectedAttributes[selectedIndex];
            <span class="attribute-selection-chip">
                @((string)attribute)
                <button type="button"
                        aria-label="@($"{attribute} aus Auswahl entfernen")"
                        @onclick="() => HandleSelectionRemoved(selectedIndex)">×</button>
            </span>
        }
    }
</div>
