<div class="probe-search-row" title="Suche nach Talenten oder Zaubern für automatisierte Proben">
    <div class="probe-search-field">
        <ProbenSearch AvailableProben="AvailableProben"
                      Placeholder="@Placeholder"
                      SelectedProbe="@SelectedProbe"
                      SelectedProbeChanged="@SelectedProbeChanged"/>
    </div>
    <MudIconButton Icon="@Icons.Material.Filled.Info"
                   Variant="Variant.Filled"
                   OnClick="InfoRequested"
                   Disabled="@(!CanShowInfo || IsBusy)"
                   title="Weitere Probeninformationen ein- oder ausblenden"
                   Class="rounded-circle probe-info-button"
                   Style="@BuildInfoButtonStyle()"/>
</div>

@if (ShowDebugForcedRolls)
{
    <div class="forced-rolls-panel" title="Optionale Testwürfe für Proben oder direkte W20-Proben">
        <span class="forced-rolls-label">Testwürfe</span>
        <input class="forced-rolls-input"
               value="@ForcedRollsText"
               @oninput="HandleForcedRollsChanged"
               disabled="@IsBusy"
               placeholder="z. B. 20,20,5 oder 6"/>
        <div class="forced-rolls-actions">
            <button type="button" class="forced-rolls-button" @onclick='() => PresetRequested.InvokeAsync("20,20,5")'
                    disabled="@IsBusy">
                Patzer
            </button>
            <button type="button" class="forced-rolls-button" @onclick='() => PresetRequested.InvokeAsync("1,1,13")'
                    disabled="@IsBusy">
                Glück
            </button>
            <button type="button" class="forced-rolls-button muted" @onclick="ClearForcedRollsRequested"
                    disabled="@IsBusy">
                Leer
            </button>
        </div>
    </div>
}
