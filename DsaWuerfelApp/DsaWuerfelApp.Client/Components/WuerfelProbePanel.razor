<div class="probe-search-row" title="Suche nach Talenten oder Zaubern für automatisierte Proben">
    <div class="probe-search-field">
        <ProbenSearch AvailableProben="AvailableProben"
                      UseFallbackCatalog="@UseFallbackCatalog"
                      Placeholder="@Placeholder"
                      SelectedProbe="@SelectedProbe"
                      SelectedProbeChanged="@SelectedProbeChanged"/>
    </div>
    <UiButton Variant="icon"
              Active="@IsInfoExpanded"
              Class="probe-info-button"
              OnClick="InfoRequested"
              Disabled="@(!CanShowInfo || IsBusy)"
              aria-label="Weitere Probeninformationen ein- oder ausblenden"
              title="Weitere Probeninformationen ein- oder ausblenden">
        <span aria-hidden="true">i</span>
    </UiButton>
</div>

@if (ProbeInfo?.SpellSelection is { Groups.Length: > 0 } spellSelection)
{
    <div class="spell-selection-panel" title="Zauberoptionen">
        <div class="spell-selection-header">
            <div class="spell-selection-heading">
                <span class="spell-selection-title">Zauberoptionen</span>
                <span class="spell-selection-global-count">@GetGlobalSelectionSummary(spellSelection)</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(spellSelection.SimultaneousModificationNote))
            {
                <p class="spell-selection-note">@spellSelection.SimultaneousModificationNote</p>
            }
        </div>

        @for (var groupIndex = 0; groupIndex < spellSelection.Groups.Length; groupIndex++)
        {
            var group = spellSelection.Groups[groupIndex];
            <details class="spell-selection-group" open="@HasSelectedOption(group)">
                <summary class="spell-selection-group-summary">
                    <span class="spell-selection-group-label">@group.Label</span>
                    <span class="spell-selection-count">@GetGroupSummary(group)</span>
                </summary>
                <div class="spell-selection-buttons">
                    @for (var optionIndex = 0; optionIndex < group.Options.Length; optionIndex++)
                    {
                        var option = group.Options[optionIndex];
                        var maximumHintId = GetMaximumHintId(groupIndex, optionIndex);
                        var maximumDisabled = IsMaximumDisabled(spellSelection, option);
                        <div class="spell-selection-option">
                            <UiButton Size="compact"
                                      Active="@option.IsSelected"
                                      Class="spell-selection-button"
                                      Disabled="@option.IsDisabled"
                                      aria-describedby="@(maximumDisabled ? maximumHintId : null)"
                                      title="@option.Description"
                                      OnClick='() => SpellOptionToggleRequested.InvokeAsync(option.Value)'>
                                @option.Label
                            </UiButton>
                            @if (maximumDisabled)
                            {
                                <span id="@maximumHintId" class="spell-option-disabled-hint">
                                    Maximum von @spellSelection.MaximumSelectableOptions erreicht
                                </span>
                            }
                        </div>
                    }
                </div>
            </details>
        }
    </div>
}

@if (ShowDebugForcedRolls)
{
    <div class="forced-rolls-panel" title="Optionale Testwürfe für Proben oder direkte W20-Proben">
        <span class="forced-rolls-label">Testwürfe</span>
        <input class="forced-rolls-input"
               value="@ForcedRollsText"
               @oninput="HandleForcedRollsChanged"
               disabled="@IsBusy"
               placeholder="z. B. 20,20,5 oder 6"/>
        <div class="forced-rolls-actions">
            <UiButton Size="compact" Class="forced-rolls-button" OnClick='() => PresetRequested.InvokeAsync("20,20,5")'
                      Disabled="@IsBusy">
                Patzer
            </UiButton>
            <UiButton Size="compact" Class="forced-rolls-button" OnClick='() => PresetRequested.InvokeAsync("1,1,13")'
                      Disabled="@IsBusy">
                Glück
            </UiButton>
            <UiButton Size="compact" Class="forced-rolls-button muted" OnClick="ClearForcedRollsRequested"
                      Disabled="@IsBusy">
                Leer
            </UiButton>
        </div>
    </div>
}
