<div class="probe-search-row" title="Suche nach Talenten oder Zaubern für automatisierte Proben">
    <div class="probe-search-field">
        <ProbenSearch AvailableProben="AvailableProben"
                      UseFallbackCatalog="@UseFallbackCatalog"
                      Placeholder="@Placeholder"
                      SelectedProbe="@SelectedProbe"
                      SelectedProbeChanged="@SelectedProbeChanged"/>
    </div>
    <MudIconButton Icon="@Icons.Material.Filled.Info"
                   Variant="Variant.Filled"
                   OnClick="InfoRequested"
                   Disabled="@(!CanShowInfo || IsBusy)"
                   title="Weitere Probeninformationen ein- oder ausblenden"
                   Class="rounded-circle probe-info-button"
                   Style="@BuildInfoButtonStyle()"/>
</div>

@if (ProbeInfo?.SpellSelection is { Groups.Length: > 0 } spellSelection)
{
    <div class="spell-selection-panel" title="Zauberoptionen">
        <div class="spell-selection-header">
            <span class="spell-selection-title">Zauberoptionen</span>
            @if (!string.IsNullOrWhiteSpace(spellSelection.SimultaneousModificationNote))
            {
                <span class="spell-selection-note">@spellSelection.SimultaneousModificationNote</span>
            }
        </div>

        @foreach (var group in spellSelection.Groups)
        {
            <details class="spell-selection-group" open="@HasSelectedOption(group)">
                <summary class="spell-selection-group-summary">
                    <span class="spell-selection-group-label">@group.Label</span>
                    <span class="spell-selection-count">@GetGroupSummary(group)</span>
                </summary>
                <div class="spell-selection-buttons">
                    @foreach (var option in group.Options)
                    {
                        <div class="spell-selection-option">
                            <button type="button"
                                    class="spell-selection-button @(option.IsSelected ? "active" : string.Empty)"
                                    disabled="@option.IsDisabled"
                                    title="@option.Description"
                                    @onclick='() => SpellOptionToggleRequested.InvokeAsync(option.Value)'>
                                @option.Label
                            </button>
                            @if (!string.IsNullOrWhiteSpace(option.Description))
                            {
                                <details class="spell-option-details">
                                    <summary title="Beschreibung anzeigen" aria-label="Beschreibung für @option.Label">i</summary>
                                    <p>@option.Description</p>
                                </details>
                            }
                        </div>
                    }
                </div>
            </details>
        }
    </div>
}

@if (ShowDebugForcedRolls)
{
    <div class="forced-rolls-panel" title="Optionale Testwürfe für Proben oder direkte W20-Proben">
        <span class="forced-rolls-label">Testwürfe</span>
        <input class="forced-rolls-input"
               value="@ForcedRollsText"
               @oninput="HandleForcedRollsChanged"
               disabled="@IsBusy"
               placeholder="z. B. 20,20,5 oder 6"/>
        <div class="forced-rolls-actions">
            <button type="button" class="forced-rolls-button" @onclick='() => PresetRequested.InvokeAsync("20,20,5")'
                    disabled="@IsBusy">
                Patzer
            </button>
            <button type="button" class="forced-rolls-button" @onclick='() => PresetRequested.InvokeAsync("1,1,13")'
                    disabled="@IsBusy">
                Glück
            </button>
            <button type="button" class="forced-rolls-button muted" @onclick="ClearForcedRollsRequested"
                    disabled="@IsBusy">
                Leer
            </button>
        </div>
    </div>
}
