@using DsaWuerfelApp.Shared

@if (ProbeInfo is not null && HasProbeInfoContent(ProbeInfo))
{
    <section class="probe-info-summary" aria-label="Kompakte Probeninformation">
        <div class="probe-info-summary-heading">
            <span class="probe-info-summary-title">Probeninfo</span>
            @if (HasProbeInfoDetails(ProbeInfo))
            {
                <span class="probe-info-summary-hint">Details ueber den Info-Button</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ProbeInfo.SummaryText))
        {
            <p class="probe-info-summary-text">@ProbeInfo.SummaryText</p>
        }

        @if (ProbeInfo.Sections.Length > 0)
        {
            <div class="probe-info-summary-fields">
                @foreach (var section in GetCompactProbeInfoSections(ProbeInfo))
                {
                    <div class="probe-info-summary-field">
                        <span class="probe-info-summary-label">@(section.Label)</span>
                        <span class="probe-info-summary-value">@(section.Text)</span>
                    </div>
                }
            </div>
        }
    </section>
}

@if (ShowProbeInfoDetails && HasProbeInfoDetails(ProbeInfo))
{
    <aside class="probe-info-details" aria-label="Vollstaendige Probeninformationen">
        <div class="probe-info-details-header">
            <h3>@GetDetailsTitle(ProbeInfo!)</h3>
            <button type="button"
                    class="probe-info-close"
                    aria-label="Probeninformationen schliessen"
                    @onclick="CloseRequested">
                Schliessen
            </button>
        </div>

        <div class="probe-info-details-content">
            @if (!string.IsNullOrWhiteSpace(ProbeInfo!.DetailsText))
            {
                <p class="probe-info-details-text">@ProbeInfo.DetailsText</p>
            }

            @if (ProbeInfo.Sections.Length > 0)
            {
                @if (HasPrimaryProbeInfoSections(ProbeInfo))
                {
                    <details class="probe-info-primary" open>
                        <summary class="probe-info-primary-title">Grundinformationen</summary>
                        <div class="probe-info-primary-fields">
                            @foreach (var section in GetPrimaryProbeInfoSections(ProbeInfo))
                            {
                                <div class="probe-info-primary-field">
                                    <span class="probe-info-primary-label">@(section.Label)</span>
                                    <p class="probe-info-primary-text">@(section.Text)</p>
                                </div>
                            }
                        </div>
                    </details>
                }

                <div class="probe-info-sections">
                    @foreach (var section in GetAdditionalProbeInfoSections(ProbeInfo))
                    {
                        <details class="probe-info-section">
                            <summary class="probe-info-section-label">@(section.Label)</summary>
                            <p class="probe-info-section-text">@(section.Text)</p>
                        </details>
                    }
                </div>
            }
        </div>
    </aside>
}

@code {
    [Parameter] public ProbeInfoResultDto? ProbeInfo { get; set; }
    [Parameter] public bool ShowProbeInfoDetails { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }

    private static bool HasProbeInfoContent(ProbeInfoResultDto probeInfo)
    {
        return !string.IsNullOrWhiteSpace(probeInfo.SummaryText) ||
               HasProbeInfoDetails(probeInfo);
    }

    private static bool HasProbeInfoDetails(ProbeInfoResultDto? probeInfo)
    {
        return probeInfo is not null &&
               (!string.IsNullOrWhiteSpace(probeInfo.DetailsText) || probeInfo.Sections.Length > 0);
    }

    private static IEnumerable<ProbeInfoSectionDto> GetCompactProbeInfoSections(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Sections.Take(3);
    }

    private static bool HasPrimaryProbeInfoSections(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Sections.Any(IsPrimaryProbeInfoSection);
    }

    private static IEnumerable<ProbeInfoSectionDto> GetPrimaryProbeInfoSections(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Sections.Where(IsPrimaryProbeInfoSection);
    }

    private static IEnumerable<ProbeInfoSectionDto> GetAdditionalProbeInfoSections(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Sections.Where(section => !IsPrimaryProbeInfoSection(section));
    }

    private static bool IsPrimaryProbeInfoSection(ProbeInfoSectionDto section)
    {
        return section.Label switch
        {
            "Probe" or "Zauberdauer" or "Wirkung" or "Kosten" or
            "Zielobjekt" or "Reichweite" or "Wirkungsdauer" => true,
            _ => false
        };
    }

    private static string GetDetailsTitle(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Kind == ProbeSelectionKind.Spell
            ? "Zauberinformationen"
            : "Probeninformationen";
    }
}
