@using DsaWuerfelApp.Shared
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

@if ((ProbeInfo is not null && HasProbeInfoContent(ProbeInfo)) || CustomContent is not null)
{
    <section class="probe-info-summary" aria-label="@CustomAriaLabel">
        <div class="probe-info-summary-heading">
            <span class="probe-info-summary-title">@CustomTitle</span>
            @if (HasProbeInfoDetails(ProbeInfo))
            {
                <span class="probe-info-summary-hint">Details ueber den Info-Button</span>
            }
        </div>

        @if (ProbeInfo is not null && !string.IsNullOrWhiteSpace(ProbeInfo.SummaryText))
        {
            <p class="probe-info-summary-text">@ProbeInfo.SummaryText</p>
        }

        @if (!string.IsNullOrWhiteSpace(CustomSummary))
        {
            <p class="probe-info-summary-text">@CustomSummary</p>
        }

        @if (CustomContent is not null)
        {
            @CustomContent
        }

        @if (ProbeInfo is not null && ProbeInfo.Sections.Length > 0)
        {
            <div class="probe-info-summary-fields">
                @foreach (var section in GetCompactProbeInfoSections(ProbeInfo))
                {
                    <div class="probe-info-summary-field">
                        <span class="probe-info-summary-label">@(section.Label)</span>
                        <span class="probe-info-summary-value">@(section.Text)</span>
                    </div>
                }
            </div>
        }
    </section>
}

@if (ShowProbeInfoDetails && (SelectedHistoryEntry is not null || HasProbeInfoDetails(ProbeInfo)))
{
    <aside class="probe-info-details"
           role="dialog"
           aria-modal="true"
           aria-label="@(SelectedHistoryEntry is null ? "Vollstaendige Probeninformationen" : "Vollstaendige Ergebnisdetails")"
           @onkeydown="HandleOverlayKeyDown">
        <div class="probe-info-details-header">
            <h3>@(SelectedHistoryEntry is null ? GetDetailsTitle(ProbeInfo!) : "Ergebnisdetails")</h3>
            <button type="button"
                    class="probe-info-close"
                    @ref="_closeButton"
                    aria-label="@GetCloseLabel()"
                    @onclick="HandleCloseRequested">
                Schliessen
            </button>
        </div>

        <div class="probe-info-details-content">
            @if (SelectedHistoryEntry is { } historyEntry)
            {
                <WuerfelCurrentRollPanel HistoryEntry="historyEntry"/>
            }
            else if (ProbeInfo is { } probeInfo)
            {
                @if (!string.IsNullOrWhiteSpace(probeInfo.DetailsText))
                {
                    <p class="probe-info-details-text">@probeInfo.DetailsText</p>
                }

                @if (probeInfo.Sections.Length > 0)
                {
                    @if (HasPrimaryProbeInfoSections(probeInfo))
                    {
                        <details class="probe-info-primary" open>
                            <summary class="probe-info-primary-title">Grundinformationen</summary>
                            <div class="probe-info-primary-fields">
                                @foreach (var section in GetPrimaryProbeInfoSections(probeInfo))
                                {
                                    <div class="probe-info-primary-field">
                                        <span class="probe-info-primary-label">@(section.Label)</span>
                                        <p class="probe-info-primary-text">@(section.Text)</p>
                                    </div>
                                }
                            </div>
                        </details>
                    }

                    <div class="probe-info-sections">
                        @foreach (var section in GetAdditionalProbeInfoSections(probeInfo))
                        {
                            <details class="probe-info-section">
                                <summary class="probe-info-section-label">@(section.Label)</summary>
                                <p class="probe-info-section-text">@(section.Text)</p>
                            </details>
                        }
                    </div>
                }
            }
        </div>
    </aside>
}

@code {
    [Parameter] public ProbeInfoResultDto? ProbeInfo { get; set; }
    [Parameter] public string CustomTitle { get; set; } = "Probeninfo";
    [Parameter] public string CustomAriaLabel { get; set; } = "Kompakte Probeninformation";
    [Parameter] public string? CustomSummary { get; set; }
    [Parameter] public RenderFragment? CustomContent { get; set; }
    [Parameter] public RollHistoryEntryDto? SelectedHistoryEntry { get; set; }
    [Parameter] public bool ShowProbeInfoDetails { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }

    private ElementReference _closeButton;
    private IJSObjectReference? _focusModule;
    private string? _focusedOverlayKey;

    private string? CurrentOverlayKey =>
        ShowProbeInfoDetails && (SelectedHistoryEntry is not null || HasProbeInfoDetails(ProbeInfo))
            ? SelectedHistoryEntry is { } entry ? GetHistoryEntryId(entry) : "probe-info"
            : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var overlayKey = CurrentOverlayKey;
        if (overlayKey is null)
        {
            _focusedOverlayKey = null;
            return;
        }

        if (string.Equals(_focusedOverlayKey, overlayKey, StringComparison.Ordinal))
        {
            return;
        }

        _focusedOverlayKey = overlayKey;
        await _closeButton.FocusAsync();
    }

    private async Task HandleOverlayKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await HandleCloseRequested();
        }
    }

    private async Task HandleCloseRequested()
    {
        var historyEntryId = SelectedHistoryEntry is { } entry ? GetHistoryEntryId(entry) : null;
        await CloseRequested.InvokeAsync();

        if (historyEntryId is null)
        {
            return;
        }

        _focusModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/focus-history.js");
        await _focusModule.InvokeVoidAsync("focusHistoryEntry", historyEntryId);
    }

    public async ValueTask DisposeAsync()
    {
        if (_focusModule is not null)
        {
            await _focusModule.DisposeAsync();
        }
    }

    private static string GetHistoryEntryId(RollHistoryEntryDto entry)
    {
        return entry.Timestamp.Ticks.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private string GetCloseLabel()
    {
        return SelectedHistoryEntry is null
            ? "Probeninformationen schliessen"
            : "Ergebnisdetails schliessen";
    }

    private static bool HasProbeInfoContent(ProbeInfoResultDto probeInfo)
    {
        return !string.IsNullOrWhiteSpace(probeInfo.SummaryText) ||
               HasProbeInfoDetails(probeInfo);
    }

    private static bool HasProbeInfoDetails(ProbeInfoResultDto? probeInfo)
    {
        return probeInfo is not null &&
               (!string.IsNullOrWhiteSpace(probeInfo.DetailsText) || probeInfo.Sections.Length > 0);
    }

    private static IEnumerable<ProbeInfoSectionDto> GetCompactProbeInfoSections(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Sections
            .Where(section => section.Label is "Probe" or "Zauberdauer" or "Kosten")
            .Take(3);
    }

    private static bool HasPrimaryProbeInfoSections(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Sections.Any(IsPrimaryProbeInfoSection);
    }

    private static IEnumerable<ProbeInfoSectionDto> GetPrimaryProbeInfoSections(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Sections.Where(IsPrimaryProbeInfoSection);
    }

    private static IEnumerable<ProbeInfoSectionDto> GetAdditionalProbeInfoSections(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Sections.Where(section => !IsPrimaryProbeInfoSection(section));
    }

    private static bool IsPrimaryProbeInfoSection(ProbeInfoSectionDto section)
    {
        return section.Label switch
        {
            "Probe" or "Zauberdauer" or "Wirkung" or "Kosten" or
            "Zielobjekt" or "Reichweite" or "Wirkungsdauer" => true,
            _ => false
        };
    }

    private static string GetDetailsTitle(ProbeInfoResultDto probeInfo)
    {
        return probeInfo.Kind == ProbeSelectionKind.Spell
            ? "Zauberinformationen"
            : "Probeninformationen";
    }
}
