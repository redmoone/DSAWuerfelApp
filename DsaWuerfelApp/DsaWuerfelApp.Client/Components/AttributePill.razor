<UiButton Variant="attribute"
          Active="@(SelectionCount > 0 || IsSelected)"
          Disabled="@(!IsAvailable)"
          OnClick="HandleClick"
          ContextMenuRequested="HandleRightClick"
          PreventContextMenu="true"
          aria-label="@(IsAvailable ? (OnClick.HasDelegate ? $"{ShortName} auswählen" : $"{ShortName} hinzufügen") : $"{ShortName} nicht verfügbar")">
    <span class="ui-pill-edge-label">@ShortName</span>
    @if (!string.IsNullOrWhiteSpace(IconPath))
    {
        <div class="attribute-icon-container">
            <img src="icons/@IconPath" alt="@ShortName" class="attribute-icon" />
        </div>
    }
    <span class="attribute-value">@(Value?.ToString() ?? "—")</span>

    @if (SelectionCount > 0)
    {
        <span class="selection-badge">@(SelectionCount)x</span>
    }
</UiButton>
