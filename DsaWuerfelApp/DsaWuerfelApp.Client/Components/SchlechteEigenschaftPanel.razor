@if (!CanDisplayTraits)
{
    <p class="additional-info-empty">Wähle zuerst einen aktiven Helden.</p>
}
else if (SchlechteEigenschaften.Count == 0)
{
    <p class="additional-info-empty">
        @(IsAggregatedSelection
            ? "Für die ausgewählten Spieler wurden keine schlechten Eigenschaften gefunden."
            : "Für den aktiven Helden wurden keine schlechten Eigenschaften gefunden.")
    </p>
}
else
{
    <div class="bad-trait-list">
        @foreach (var eigenschaft in SortedSchlechteEigenschaften)
        {
            var owners = GetOwners(eigenschaft.Name);
            <button type="button"
                    class="bad-trait-chip @(IsSelected(eigenschaft.Name) ? "active" : "") @(IsAggregatedSelection ? "aggregated" : "")"
                    @onclick='() => HandleSelectionChanged(eigenschaft.Name)'
                    disabled="@IsBusy">
                <span class="bad-trait-chip-header">
                    <span>@eigenschaft.Name</span>
                    <span class="bad-trait-chip-meta">@GetChipMeta(eigenschaft)</span>
                </span>

                @if (IsAggregatedSelection && owners.Count > 0)
                {
                    <span class="bad-trait-owner-badges">
                        @foreach (var owner in owners)
                        {
                            <span class="bad-trait-owner-badge">@FormatOwnerBadge(owner)</span>
                        }
                    </span>
                }
            </button>
        }
    </div>

    @if (SelectedEigenschaft is { } selectedEigenschaft)
    {
        @if (IsAggregatedSelection)
        {
            <div class="bad-trait-summary">
                <span>Talentproben: individuell</span>
                <span>Eigenschaftsproben: individuell</span>
            </div>

            @if (SelectedEigenschaftOwners.Count > 0)
            {
                <div class="bad-trait-owner-badges detail">
                    @foreach (var owner in SelectedEigenschaftOwners)
                    {
                        <span class="bad-trait-owner-badge">
                            @owner.PlayerName
                            <span class="bad-trait-owner-badge-value">@owner.Value</span>
                        </span>
                    }
                </div>
            }

            <p class="additional-info-empty bad-trait-hint">
                Beim Sammelwurf wird die Erschwernis nur bei Spielern angewendet, die diese Eigenschaft besitzen.
            </p>
        }
        else
        {
            <div class="bad-trait-summary">
                <span>Talentproben: @FormatModifier(selectedEigenschaft.TalentModifier)</span>
                <span>Eigenschaftsproben: @FormatModifier(selectedEigenschaft.AttributeModifier)</span>
            </div>

            <button class="dsa-btn" @onclick="HandleDirectRollRequested" disabled="@IsBusy">
                W20 auf @selectedEigenschaft.Name
            </button>
        }
    }
    else
    {
        <p class="additional-info-empty">
            @(IsAggregatedSelection
                ? "Wähle eine schlechte Eigenschaft, um die betroffenen Spieler und ihre Werte zu sehen."
                : "Wähle eine relevante schlechte Eigenschaft, um ihre Erschwernis zu aktivieren oder direkt darauf zu würfeln.")
        </p>
    }
}
