@if (!HasActiveHero)
{
    <p class="additional-info-empty">Waehle zuerst einen aktiven Helden.</p>
}
else if (SchlechteEigenschaften.Count == 0)
{
    <p class="additional-info-empty">Fuer den aktiven Helden wurden keine schlechten Eigenschaften gefunden.</p>
}
else
{
    <div class="bad-trait-list">
        @foreach (var eigenschaft in SortedSchlechteEigenschaften)
        {
            <button type="button"
                    class="bad-trait-chip @(IsSelected(eigenschaft.Name) ? "active" : "")"
                    @onclick='() => HandleSelectionChanged(eigenschaft.Name)'
                    disabled="@IsBusy">
                <span>@eigenschaft.Name</span>
                <span>@eigenschaft.Value</span>
            </button>
        }
    </div>

    @if (SelectedEigenschaft is { } selectedEigenschaft)
    {
        <div class="bad-trait-summary">
            <span>Talentproben: @FormatModifier(selectedEigenschaft.TalentModifier)</span>
            <span>Eigenschaftsproben: @FormatModifier(selectedEigenschaft.AttributeModifier)</span>
        </div>

        <button class="dsa-btn" @onclick="HandleDirectRollRequested" disabled="@IsBusy">
            W20 auf @selectedEigenschaft.Name
        </button>
    }
    else
    {
        <p class="additional-info-empty">
            Waehle eine relevante schlechte Eigenschaft, um ihre Erschwernis zu aktivieren oder direkt darauf zu
            wuerfeln.
        </p>
    }
}
