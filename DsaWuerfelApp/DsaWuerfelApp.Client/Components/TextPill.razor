<div class="text-pill">
    <span class="ui-pill-edge-label">@Label</span>
    <div class="text-pill-inner">
        <input class="text-pill-input"
               type="@InputType"
               value="@Value"
               @oninput="HandleInput"
               placeholder="@Placeholder"
               disabled="@Disabled"/>
    </div>
</div>
