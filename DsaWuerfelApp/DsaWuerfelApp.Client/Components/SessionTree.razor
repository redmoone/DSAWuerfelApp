@using System.Linq
@implements IDisposable

@if (Sessions.Count == 0)
{
    <div class="session-tree-empty">@EmptyText</div>
}
else
{
    <div class="session-tree">
        @foreach (var session in Sessions)
        {
            var isExpanded = _expandedSessionIds.Contains(session.SessionId);
            var isActive = string.Equals(session.SessionId, ActiveSessionId, StringComparison.Ordinal);
            var canManage = ShowManagement && CanManage(session);
            var isEditing = string.Equals(_editingSessionId, session.SessionId, StringComparison.Ordinal);
            var onlinePlayerCount = session.Players.Count(player => player.IsOnline);
            var feedback = GetFeedback(session.SessionId);
            var pendingAction = GetPendingAction(session.SessionId);

            <section @key="session.SessionId"
                     id="@GetSessionNodeId(session.SessionId)"
                     class="session-node @(isActive ? "active" : string.Empty)">
                <div class="session-header">
                    <button type="button"
                            class="session-toggle @(isActive ? "active" : string.Empty)"
                            @onclick="() => ToggleExpanded(session.SessionId)"
                            aria-expanded="@(isExpanded ? "true" : "false")"
                            aria-controls="@GetDetailsId(session.SessionId)">
                        <span class="session-chevron @(isExpanded ? "expanded" : string.Empty)">&gt;</span>
                        <span class="session-summary">
                            <span class="session-name">@session.Name</span>
                            @if (isActive)
                            {
                                <span class="session-status">Aktiv</span>
                            }
                        </span>
                    </button>

                    <div class="session-header-meta">
                        <span class="session-player-count">@session.Players.Length Spieler · @onlinePlayerCount online</span>
                        <button type="button"
                                class="session-open-btn @(isActive ? "primary" : string.Empty)"
                                disabled="@HasBusyOperation"
                                @onclick="() => OpenAsync(session.SessionId)">
                            @(isActive ? "Weiterwürfeln" : "Öffnen")
                        </button>
                    </div>
                </div>

                @if (feedback is not null)
                {
                    <div class="session-feedback @(feedback.IsError ? "error" : "success")"
                         role="@(feedback.IsError ? "alert" : "status")">
                        @feedback.Message
                    </div>
                }

                @if (IsBusy(session.SessionId))
                {
                    <div class="session-busy" role="status">Wird verarbeitet …</div>
                }

                @if (isExpanded)
                {
                    <div id="@GetDetailsId(session.SessionId)"
                         class="session-body"
                         aria-labelledby="@GetSessionNodeId(session.SessionId)">
                        @if (ShowJoinCode)
                        {
                            <div class="session-code-row">
                                <div class="session-code-label">Beitrittscode</div>
                                <code class="session-code">@session.JoinCode</code>
                                @if (ShowCopyButton)
                                {
                                    <button type="button"
                                            class="session-code-btn"
                                            title="Code kopieren"
                                            aria-label="Code kopieren"
                                            disabled="@HasBusyOperation"
                                            @onclick="() => CopyJoinCodeAsync(session.SessionId)">
                                        <img src="icons/copy.svg" class="session-icon" alt=""/>
                                        <span>Code kopieren</span>
                                    </button>
                                }
                            </div>
                        }

                        <section class="session-members" aria-label="Mitglieder">
                            <h3 class="session-section-title">Mitglieder</h3>
                            @foreach (var player in session.Players)
                            {
                                var canEditPlayer = CanEditPlayer(player);
                                var isEditingPlayer = string.Equals(_editingPlayerSessionId, session.SessionId, StringComparison.Ordinal) &&
                                                      string.Equals(_editingPlayerUserId, player.UserId, StringComparison.Ordinal);

                                <div class="session-member @(player.IsMaster ? "master" : string.Empty)">
                                    <div class="session-member-identity">
                                        <span class="session-member-presence @(player.IsOnline ? "online" : "offline")" aria-hidden="true"></span>
                                        <span class="session-member-presence-text">@(player.IsOnline ? "Online" : "Offline")</span>
                                        @if (player.IsMaster)
                                        {
                                            <span class="session-member-role">Meister</span>
                                        }

                                        @if (isEditingPlayer)
                                        {
                                            <div class="session-member-edit">
                                                <label for="@GetPlayerEditorId(session.SessionId, player.UserId)">Dein Name für diese Session</label>
                                                <input id="@GetPlayerEditorId(session.SessionId, player.UserId)"
                                                       class="session-member-input"
                                                       @bind="_editingPlayerName"
                                                       @bind:event="oninput"
                                                       maxlength="40"
                                                       placeholder="Spielername"
                                                       disabled="@HasBusyOperation"/>

                                                <div class="session-member-edit-actions">
                                                    <button type="button"
                                                            class="session-action-btn primary"
                                                            disabled="@HasBusyOperation"
                                                            @onclick="() => SavePlayerRenameAsync(session.SessionId)">
                                                        Speichern
                                                    </button>
                                                    <button type="button"
                                                            class="session-action-btn secondary"
                                                            disabled="@HasBusyOperation"
                                                            @onclick="CancelPlayerRename">
                                                        Abbrechen
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="session-member-name">@player.Name</span>

                                            @if (canEditPlayer)
                                            {
                                                <button type="button"
                                                        class="session-icon-btn secondary session-player-edit-btn"
                                                        title="Deinen Namen in dieser Session ändern"
                                                        aria-label="Deinen Namen in dieser Session ändern"
                                                        disabled="@HasBusyOperation"
                                                        @onclick="() => BeginPlayerRename(session.SessionId, player)">
                                                    <img src="icons/edit.svg" class="session-icon" alt=""/>
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </section>

                        @if (canManage)
                        {
                            <section class="session-management" aria-labelledby="@GetManagementId(session.SessionId)">
                                <h3 id="@GetManagementId(session.SessionId)" class="session-section-title">Sessionverwaltung</h3>
                                @if (isEditing)
                                {
                                    <label for="@GetSessionEditorId(session.SessionId)">Sessionname</label>
                                    <input id="@GetSessionEditorId(session.SessionId)"
                                           class="session-edit-input"
                                           @bind="_editingName"
                                           @bind:event="oninput"
                                           maxlength="80"
                                           placeholder="Sessionname"
                                           disabled="@HasBusyOperation"/>

                                    <div class="session-manage-actions">
                                        <button type="button"
                                                class="session-action-btn primary"
                                                disabled="@HasBusyOperation"
                                                @onclick="() => SaveRenameAsync(session.SessionId)">
                                            Speichern
                                        </button>
                                        <button type="button"
                                                class="session-action-btn secondary"
                                                disabled="@HasBusyOperation"
                                                @onclick="CancelRename">
                                            Abbrechen
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="session-manage-actions">
                                        <button type="button"
                                                class="session-action-btn"
                                                disabled="@HasBusyOperation"
                                                @onclick="() => BeginRename(session.SessionId)">
                                            Umbenennen
                                        </button>
                                        <button type="button"
                                                class="session-action-btn danger"
                                                disabled="@HasBusyOperation"
                                                @onclick="() => BeginDelete(session.SessionId)">
                                            Löschen
                                        </button>
                                    </div>
                                }
                            </section>
                        }

                        <section class="session-leave" aria-label="Session verlassen">
                            <button type="button"
                                    class="session-action-btn secondary"
                                    disabled="@HasBusyOperation"
                                    @onclick="() => BeginLeave(session.SessionId)">
                                Session verlassen
                            </button>
                        </section>

                        @if (pendingAction is not null)
                        {
                            <div class="session-confirmation" role="alert">
                                <p>@GetPendingMessage(session, pendingAction.Value)</p>
                                <div class="session-manage-actions">
                                    <button type="button"
                                            class="session-action-btn primary"
                                            disabled="@HasBusyOperation"
                                            @onclick="ConfirmPendingActionAsync">
                                        Bestätigen
                                    </button>
                                    <button type="button"
                                            class="session-action-btn secondary"
                                            disabled="@HasBusyOperation"
                                            @onclick="CancelPendingAction">
                                        Abbrechen
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
}
