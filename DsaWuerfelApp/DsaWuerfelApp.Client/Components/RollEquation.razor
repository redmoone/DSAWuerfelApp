<div class="roll-equation-pill">
    @if (Result is null)
    {
        <span class="equation-text">Bereit zum Würfeln</span>
    }
    else
    {
        <span class="equation-text">@EquationText</span>
        <span class="equation-equals">=</span>
        <span class="equation-total">@Result.Total</span>
    }
</div>