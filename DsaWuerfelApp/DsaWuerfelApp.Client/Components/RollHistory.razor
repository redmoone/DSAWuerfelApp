@using DsaWuerfelApp.Client.Services
@inject GameClient GameClient

<div class="chat-panel">
    <div class="chat-history-container">
        @if (_history.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="text-muted text-center my-4">Noch keine Würfe in dieser Session.</MudText>
        }
        
        <div class="d-flex flex-column">
            @foreach (var log in _history)
            {
                <div class="chat-message">
                    <div class="d-flex align-baseline gap-2 mb-1">
                        <span class="chat-author">@log.PlayerName</span>
                        <span class="chat-time">@log.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                    </div>
                    
                    <div class="d-flex align-center flex-wrap gap-1">
                        @for (int i = 0; i < log.Rolls.Count; i++)
                        {
                            var r = log.Rolls[i];
                            <div class="history-die-container">
                                <div class="die-shape history-die shape-d@(r.Sides)">
                                    <span class="die-text">@r.Value</span>
                                </div>
                            </div>

                            @if (i < log.Rolls.Count - 1)
                            {
                                <span class="math-symbol">+</span>
                            }
                        }
                        
                        @if (log.Modifier > 0)
                        {
                            <span class="math-symbol">+</span>
                            <span class="modifier-value">@log.Modifier</span>
                        }
                        else if (log.Modifier < 0)
                        {
                            <span class="math-symbol">-</span>
                            <span class="modifier-value">@(Math.Abs(log.Modifier))</span>
                        }
                        
                        <span class="math-symbol mx-2">=</span>
                        <span class="chat-total">@log.TotalSum</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>