@page "/wuerfel"
@using DsaWuerfelApp.Client.Components
@using DsaWuerfelApp.Client.Components.Combat
@using DsaWuerfelApp.Client.Services
@using DsaWuerfelApp.Shared
@attribute [Authorize]

<div class="wuerfel-page-container pa-4">
    <section class="wuerfel-status-surface panel-surface">
        <CombatStatusPanel HeroName="@CombatHeroDisplayName"
                           SessionName="@SessionState.ActiveSession?.Name"
                           Profile="@CombatProfile"
                           IsLoading="@CombatProfileLoading"
                           ErrorMessage="@CombatProfileError"
                           CurrentLeP="@CombatCurrentLeP"
                           CurrentAuP="@CombatCurrentAuP"
                           CurrentAeP="@CombatCurrentAeP"
                           CurrentKeP="@CombatCurrentKeP"
                           CurrentInitiative="@CombatCurrentInitiative"
                           IsCombatStarted="@CombatState.IsStarted"
                           CanStartCombat="@(!CombatState.IsStarted)"
                           StartCombatRequested="InitializeCombatStateAsync"
                           CanUndo="@CombatCanUndo"
                           UndoRequested="UndoCombatChangeAsync"
                           ResourceEditRequested="OpenCombatResourceDrawer"
                           ResourceValueChangedRequested="HandleCombatResourceValueChanged"
                           InitiativeRequested="OpenCombatInitiativeDrawer"
                           WoundsRequested="OpenCombatWoundDrawer"
                           IsMutationBusy="@_combatResourceBusy"
                           PersistenceWarning="@CombatState.PersistenceError"
                           Wounds="@CombatWounds"
                           Effects="@CombatEffects" />
        @if (!string.IsNullOrWhiteSpace(_combatNotice))
        {
            <p class="wuerfel-combat-notice" role="status">@_combatNotice</p>
        }
    </section>

    <nav class="roll-mode-selector" role="tablist" aria-label="Wurfmodus">
        <UiButton Variant="tab"
                  Active="@(VisibleArea == WuerfelArea.ProbeSearch)"
                  role="tab"
                  data-testid="mode-probe"
                  aria-selected="@(VisibleArea == WuerfelArea.ProbeSearch)"
                  OnClick="() => ActivateAreaAsync(WuerfelArea.ProbeSearch)">
            Talent / Zauber
        </UiButton>
        <UiButton Variant="tab"
                  Active="@(VisibleArea == WuerfelArea.Attributes)"
                  role="tab"
                  data-testid="mode-attribute"
                  aria-selected="@(VisibleArea == WuerfelArea.Attributes)"
                  OnClick="() => ActivateAreaAsync(WuerfelArea.Attributes)">
            Eigenschaft
        </UiButton>
        <UiButton Variant="tab"
                  Active="@(VisibleArea == WuerfelArea.BadTrait)"
                  role="tab"
                  data-testid="mode-bad-trait"
                  aria-selected="@(VisibleArea == WuerfelArea.BadTrait)"
                  OnClick="() => ActivateAreaAsync(WuerfelArea.BadTrait)">
            Schlechte Eigenschaft
        </UiButton>
        <UiButton Variant="tab"
                  Active="@(VisibleArea == WuerfelArea.FreeRoll)"
                  role="tab"
                  data-testid="mode-free-roll"
                  aria-selected="@(VisibleArea == WuerfelArea.FreeRoll)"
                  OnClick="() => ActivateAreaAsync(WuerfelArea.FreeRoll)">
            Freier Wurf
        </UiButton>
    </nav>

    <div class="roll-workspace">
        <section class="roll-setup-panel" aria-labelledby="roll-setup-title">
            <div class="roll-setup-header">
                <div>
                    <h1 id="roll-setup-title">Wurf vorbereiten</h1>
                    <p>Modus wählen, Werte prüfen und den Wurf abschließen.</p>
                </div>
            </div>

            @if (IsSessionMaster)
            {
                <details class="master-selection-details">
                    <summary>
                        <span>Meisterziele</span>
                        <span class="master-selection-summary">@MasterTargetSummary</span>
                    </summary>
                    <div class="master-selection-content">
                        <div class="master-selection-actions">
                            <UiButton Size="compact"
                                      Class="master-selection-button"
                                      OnClick="SelectAllMasterTargetsAsync"
                                      Disabled="@(AvailableMasterTargets.Count == 0 || IsAllMasterTargetsSelected)">
                                Alle
                            </UiButton>
                            <UiButton Size="compact"
                                      Class="master-selection-button muted"
                                      OnClick="ClearMasterTargetsAsync"
                                      Disabled="@(_selectedMasterTargetUserIds.Count == 0)">
                                Einzelwurf
                            </UiButton>
                        </div>

                        @if (AvailableMasterTargets.Count == 0)
                        {
                            <p class="master-selection-empty">Noch kein Spieler mit aktivem Helden in der Session.</p>
                        }
                        else
                        {
                            <div class="master-target-grid">
                                @foreach (var target in AvailableMasterTargets)
                                {
                                    <UiButton Variant="option"
                                              Size="compact"
                                              Class="master-target-chip"
                                              Active="@IsMasterTargetSelected(target.UserId)"
                                              OnClick="() => ToggleMasterTargetAsync(target.UserId)">
                                        <span class="master-target-name">@target.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(target.ActiveHeroName))
                                        {
                                            <span class="master-target-hero">@target.ActiveHeroName</span>
                                        }
                                    </UiButton>
                                }
                            </div>
                        }
                    </div>
                </details>
            }

            <div class="roll-setup-content">
                @if (VisibleArea == WuerfelArea.ProbeSearch)
                {
                    <section class="setup-section probe-setup-section" aria-labelledby="probe-setup-title">
                        <h2 id="probe-setup-title" class="setup-section-title">Talent oder Zauber</h2>
                        <WuerfelProbePanel AvailableProben="View.AvailableProbes"
                                           UseFallbackCatalog="@(!View.IsMasterMode)"
                                           Placeholder="@View.ProbePlaceholder"
                                           SelectedProbe="@(View.SelectedProbeValue ?? string.Empty)"
                                           ProbeInfo="View.ProbeInfo"
                                           SelectedProbeChanged="HandleSelectedProbeChangedAsync"
                                           SpellOptionToggleRequested="HandleSpellOptionToggleAsync"
                                           InfoRequested="ToggleProbeInfoAsync"
                                           CanShowInfo="@(!string.IsNullOrWhiteSpace(View.SelectedProbeValue))"
                                           IsInfoExpanded="View.IsProbeInfoExpanded"
                                           ShowDebugForcedRolls="View.ShowDebugForcedRolls"
                                           ForcedRollsText="@View.ForcedRollsText"
                                           ForcedRollsTextChanged="HandleForcedRollsChanged"
                                           PresetRequested="HandleForcedRollPreset"
                                           ClearForcedRollsRequested="ClearForcedRolls"
                                           IsBusy="View.IsBusy"/>
                    </section>

                    <section class="setup-section optional-bad-trait-section" aria-labelledby="probe-bad-trait-title">
                        <h2 id="probe-bad-trait-title" class="setup-section-title">Schlechte Eigenschaft</h2>
                        <SchlechteEigenschaftPanel HasActiveHero="@(View.HasActiveHero || View.IsMasterMode)"
                                                   IsAggregatedSelection="View.IsMultiMasterMode"
                                                   SchlechteEigenschaften="View.BadTraits"
                                                   BadTraitOwners="View.BadTraitOwners"
                                                   SelectedName="@View.SelectedBadTraitName"
                                                   SelectedNameChanged="HandleSelectedBadTraitChanged"
                                                   OnDirectRollRequested="ExecuteBadTraitRollAsync"
                                                   AllowDirectRoll="false"
                                                   Compact="true"
                                                   IsBusy="View.IsBusy"/>
                    </section>
                }
                else if (VisibleArea == WuerfelArea.Attributes)
                {
                    <section class="setup-section attribute-setup-section" aria-labelledby="attribute-setup-title">
                        <h2 id="attribute-setup-title" class="setup-section-title">Eigenschaftsprobe</h2>
                        <AttributePanel AttributeValues="View.AttributeValues"
                                        SelectedAttributes="View.SelectedAttributes"
                                        OnAttributeAdded="AddAttributeAsync"
                                        OnAttributeRemoved="RemoveAttributeAsync"
                                        OnAttributeRemovedAt="RemoveAttributeAtAsync"/>
                    </section>

                    <section class="setup-section optional-bad-trait-section" aria-labelledby="attribute-bad-trait-title">
                        <h2 id="attribute-bad-trait-title" class="setup-section-title">Schlechte Eigenschaft</h2>
                        <SchlechteEigenschaftPanel HasActiveHero="@(View.HasActiveHero || View.IsMasterMode)"
                                                   IsAggregatedSelection="View.IsMultiMasterMode"
                                                   SchlechteEigenschaften="View.BadTraits"
                                                   BadTraitOwners="View.BadTraitOwners"
                                                   SelectedName="@View.SelectedBadTraitName"
                                                   SelectedNameChanged="HandleSelectedBadTraitChanged"
                                                   OnDirectRollRequested="ExecuteBadTraitRollAsync"
                                                   AllowDirectRoll="false"
                                                   Compact="true"
                                                   IsBusy="View.IsBusy"/>
                    </section>
                }
                else if (VisibleArea == WuerfelArea.BadTrait)
                {
                    <section class="setup-section bad-trait-setup-section" aria-labelledby="bad-trait-setup-title">
                        <h2 id="bad-trait-setup-title" class="setup-section-title">Schlechte Eigenschaft prüfen</h2>
                        <SchlechteEigenschaftPanel HasActiveHero="@(View.HasActiveHero || View.IsMasterMode)"
                                                   IsAggregatedSelection="View.IsMultiMasterMode"
                                                   SchlechteEigenschaften="View.BadTraits"
                                                   BadTraitOwners="View.BadTraitOwners"
                                                   SelectedName="@View.SelectedBadTraitName"
                                                   SelectedNameChanged="HandleSelectedBadTraitChanged"
                                                   OnDirectRollRequested="ExecuteBadTraitRollAsync"
                                                   IsBusy="View.IsBusy"/>
                    </section>
                }
                else if (VisibleArea == WuerfelArea.FreeRoll)
                {
                    <section class="setup-section free-roll-setup-section" aria-labelledby="free-roll-setup-title">
                        <h2 id="free-roll-setup-title" class="setup-section-title">Freier Wurf</h2>
                        <div title="Manuelle Auswahl der Würfel">
                            <DiceControls AvailableSides="_availableSides" OnAddDie="AddDieAsync"/>
                        </div>
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(View.ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="roll-error">@View.ErrorMessage</MudAlert>
                }

            </div>
            <WuerfelInformationPanel ProbeInfo="@View.ProbeInfo"
                                     SelectedHistoryEntry="@View.SelectedHistoryEntry"
                                     ShowProbeInfoDetails="@View.IsProbeInfoExpanded"
                                     CloseRequested="CloseDetailsAsync"/>
        </section>

        <section class="roll-feedback-column" aria-label="Wurfergebnis und Historie">
            <div class="roll-results-area">
                @if (View.AnimatedDiceSides.Count > 0 || View.SelectedDiceSides.Count > 0)
                {
                    <div class="dice-3d-box @(View.AnimatedDiceSides.Count > 0 ? "has-result" : "has-selection")"
                         title="3D Ansicht der gefallenen Würfel">
                        <DiceViewport SelectedDice="View.SelectedDiceSides"
                                      ResultDiceSides="View.AnimatedDiceSides"
                                      ResultDiceValues="View.AnimatedDiceValues"
                                      PreviewVersion="View.PreviewVersion"
                                      ResultVersion="View.ResultVersion"
                                      OnDiceRemoved="HandleDiceRemovedAsync"/>
                    </div>
                }
                @if (VisibleArea != WuerfelArea.BadTrait)
                {
                    <WuerfelActionBar RollText="@View.RollText"
                                      RollTextChanged="HandleRollTextChanged"
                                      Modifier="@View.Modifier"
                                      DisplayModifier="@View.EffectiveModifier"
                                      ModifierChanged="HandleModifierChanged"
                                      IsHiddenRoll="@View.IsHiddenRoll"
                                      ToggleHiddenRollRequested="ToggleHiddenRoll"
                                      ResetRequested="ResetAsync"
                                      RollRequested="ExecuteRollAsync"
                                      CanRoll="View.CanRoll"
                                      IsBusy="View.IsBusy"
                                      AllowDirectModifierInput="true"/>
                }
            </div>
            <section class="history-panel" data-testid="history-panel" aria-labelledby="history-title">
                <div class="history-panel-heading">
                    <h2 id="history-title">Historie · @View.History.Count Würfe</h2>
                </div>
                <RollHistory Entries="View.History" EntrySelected="HandleHistoryEntrySelected"/>
            </section>
        </section>
    </div>
</div>

<CombatDetailsDrawer Open="@(_combatDrawer != WuerfelCombatDrawer.None)"
                     Title="@CombatDrawerTitle"
                     CloseRequested="CloseCombatDrawer">
    @if (_combatDrawer == WuerfelCombatDrawer.Resource && _combatResourceKind is { } resource)
    {
        <div class="wuerfel-combat-drawer-form">
            <p class="combat-drawer-lead">@GetCombatResourceDescription(resource)</p>
            <NumberControl Label="@GetCombatResourceLabel(resource)"
                           Value="@_combatResourceDraft"
                           ValueChanged="HandleCombatResourceDraftChanged"
                           Minimum="@GetCombatResourceMinimum(resource)"
                           StepMaximum="@GetCombatResourceMaximum(resource)"
                           AllowEmpty="true" />
            <p class="combat-drawer-hint">LeP darf unter 0 fallen. Das Maximum begrenzt nur die Plus-Schritte; ein übermaximaler Wert bleibt erhalten.</p>
            <div class="combat-drawer-actions">
                <UiButton Variant="primary" OnClick="ApplyCombatResourceAsync">Anwenden</UiButton>
                <UiButton OnClick="CloseCombatDrawer">Abbrechen</UiButton>
            </div>
        </div>
    }
    else if (_combatDrawer == WuerfelCombatDrawer.Wound)
    {
        <div class="wuerfel-combat-drawer-form">
            <CombatBodyPanel SelectedSet="@CombatSelectedSet"
                             Facing="@CombatFacing"
                             FacingChanged="HandleCombatFacingChanged"
                             SelectedZone="@CombatSelectedZone"
                             ZoneSelected="HandleCombatZoneSelected"
                             Wounds="@CombatWounds" />
            <p class="combat-drawer-lead">@GetCombatWoundLabel(CombatWoundDrawerZone) · @GetCombatArmorFacingLabel()</p>
            <div class="combat-wound-markers" aria-label="Wundmarker">
                @for (var marker = 1; marker <= 3; marker++)
                {
                    <span class="combat-wound-marker @(((_combatWoundDraft ?? 0) >= marker) ? "filled" : string.Empty)">@marker</span>
                }
            </div>
            <NumberControl Label="Wunden"
                           Value="@_combatWoundDraft"
                           ValueChanged="HandleCombatWoundDraftChanged"
                           Minimum="0"
                           Maximum="3" />
            <p class="combat-drawer-hint">Brust und Rücken teilen den Wundstand, behalten aber getrennte RS-Werte.</p>
            <div class="combat-drawer-actions">
                <UiButton Variant="primary" OnClick="ApplyCombatWoundAsync">Anwenden</UiButton>
                <UiButton OnClick="CloseCombatDrawer">Abbrechen</UiButton>
            </div>
        </div>
    }
    else if (_combatDrawer == WuerfelCombatDrawer.Initiative)
    {
        <div class="wuerfel-combat-drawer-form">
            <p class="combat-drawer-lead">Der importierte Setwert wird einmal als Basis verwendet. Der Hilfswurf liefert den W6-Anteil.</p>
            <NumberControl Label="INI"
                           Value="@_combatInitiativeDraft"
                           ValueChanged="HandleCombatInitiativeDraftChanged"
                           AllowEmpty="true" />
            <div class="combat-drawer-actions">
                <UiButton Variant="primary" Disabled="@(CombatProfile is null || _combatInitiativeBusy)" OnClick="RollCombatInitiativeAsync">1W6 würfeln</UiButton>
                <UiButton OnClick="ApplyCombatInitiativeAsync">Wert setzen</UiButton>
                <UiButton OnClick="CloseCombatDrawer">Abbrechen</UiButton>
            </div>
        </div>
    }
</CombatDetailsDrawer>
