@page "/wuerfel"
@using DsaWuerfelApp.Client.Components

<MudPaper Class="google-dice-container pa-4" Elevation="3">
    <div class="stage-wrapper">
        <div class="dice-canvas">
            <Dice3D @ref="_dice3d" />
        </div>

        @if (_selected.Count > 0)
        {
            <div class="total-overlay">
                <span class="total-label">Total</span>
                <span class="total-value">@(_last?.Total ?? 0)</span>
            </div>
        }
    </div>

    <MudDivider Class="my-4" />

    <div class="d-flex justify-center flex-wrap gap-6 align-center">
        @foreach (var s in _availableSides)
        {
            <div class="die-selector" @onclick="() => AddDie(s)">
                <div class="die-shape @GetShapeClass(s)">
                    <span class="die-text">@s</span>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-center align-center gap-4 mt-6">
        <MudToggleIconButton @bind-Toggled="_showModifier"
                             Icon="@Icons.Material.Filled.Exposure"
                             ToggledIcon="@Icons.Material.Filled.Check"
                             Color="Color.Default" ToggledColor="Color.Primary" />

        @if (_showModifier)
        {
            <MudNumericField @bind-Value="_modifier" Variant="Variant.Outlined"
                             Margin="Margin.Dense" Class="modifier-input"
                             Label="Mod" Min="-99" Max="99" />
        }
        else if (_modifier != 0)
        {
             <MudChip T="string" Size="Size.Small" OnClose="() => _modifier = 0">
                 @(_modifier > 0 ? $"+{_modifier}" : _modifier.ToString())
             </MudChip>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" OnClick="Roll"
                   Disabled="@(_selected.Count == 0)" Class="px-8 rounded-pill">
            Roll
        </MudButton>

        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reset" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }
</MudPaper>