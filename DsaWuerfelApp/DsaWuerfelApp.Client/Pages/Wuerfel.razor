@page "/wuerfel"
@using DsaWuerfelApp.Client.Components

<div class="google-dice-container pa-4">
    <div class="stage-wrapper">
        <div class="dice-canvas">
            <Dice3D @ref="_dice3d" />
        </div>

        @if (_selected.Count > 0)
        {
            <div class="total-overlay">
                <span class="total-label">Total</span>
                <span class="total-value">@(_last?.Total ?? 0)</span>
            </div>
        }
    </div>

    <MudDivider Class="my-4" />

    <div class="d-flex justify-center flex-wrap gap-6 align-center">
        @foreach (var s in _availableSides)
        {
            <div class="die-selector" @onclick="() => AddDie(s)">
                <div class="die-shape @GetShapeClass(s)">
                    <span class="die-text">@s</span>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-center align-center gap-4 mt-6">
        
        <div class="d-flex align-center pa-1" style="border: 1px solid #e0e0e0; border-radius: 24px;">
            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="@(() => _modifier--)" />
            
            <input type="number" @bind="_modifier" 
                   style="width: 50px; text-align: center; border: none; outline: none; font-weight: 500; font-size: 1rem;" />

            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => _modifier++)" />
        </div>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" OnClick="Roll"
                   Disabled="@(_selected.Count == 0)" Class="px-8 rounded-pill">
            Roll
        </MudButton>

        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reset" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }
</div>