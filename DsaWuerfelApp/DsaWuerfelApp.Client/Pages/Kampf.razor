@page "/kampf"
@using DsaWuerfelApp.Client.Components
@attribute [Authorize]

<div class="combat-container">
    <div class="split-view pa-4">
        <div class="left-column">
            <div class="combat-zone hero-panel">
                <h2 class="zone-title">Held</h2>

                <div class="status-bars">
                    <div class="status-row">
                        <span class="status-label">LeP</span>
                        <MudProgressLinear Color="Color.Error" Value="100" height="20px" Striped="true"
                                           Class="flex-grow-1"/>
                    </div>
                    <div class="status-row mt-2">
                        <span class="status-label">AuP</span>
                        <MudProgressLinear Color="Color.Success" Value="100" height="20px" Striped="true"
                                           Class="flex-grow-1"/>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3 my-5">
                    <AttributePill ShortName="AT" Value="15" IconPath="sword.svg"/>
                    <AttributePill ShortName="PA" Value="13" IconPath="shield.svg"/>
                    <AttributePill ShortName="INI" Value="12" IconPath="feather.svg"/>
                    <AttributePill ShortName="RS" Value="4" IconPath="weight.svg"/>
                    <AttributePill ShortName="FK" Value="14" IconPath="icons/search.svg"/>
                    <AttributePill ShortName="GS" Value="8" IconPath="icons/feather.svg"/>
                    <AttributePill ShortName="BE" Value="1" IconPath="icons/weight.svg"/>
                </div>

                <div class="d-flex flex-wrap gap-2 my-4 justify-center">
                    <AttributePill ShortName="MU" Value="14" IconPath="lion.svg"
                                   OnClick="@(() => RollAttribute("MU", 14))"/>
                    <AttributePill ShortName="KL" Value="13" IconPath="owl.svg"
                                   OnClick="@(() => RollAttribute("KL", 13))"/>
                    <AttributePill ShortName="IN" Value="15" IconPath="eye.svg"
                                   OnClick="@(() => RollAttribute("IN", 15))"/>
                    <AttributePill ShortName="CH" Value="12" IconPath="mask.svg"
                                   OnClick="@(() => RollAttribute("CH", 12))"/>
                    <AttributePill ShortName="FF" Value="15" IconPath="hand.svg"
                                   OnClick="@(() => RollAttribute("FF", 15))"/>
                    <AttributePill ShortName="GE" Value="15" IconPath="cat.svg"
                                   OnClick="@(() => RollAttribute("GE", 15))"/>
                    <AttributePill ShortName="KO" Value="14" IconPath="shield.svg"
                                   OnClick="@(() => RollAttribute("KO", 14))"/>
                    <AttributePill ShortName="KK" Value="13" IconPath="muscle.svg"
                                   OnClick="@(() => RollAttribute("KK", 13))"/>
                </div>

                <div class="helden-details-container">
                    <div class="wounds-section">
                        <h4 class="zone-subtitle">Wunden</h4>
                        <div class="wounds-tracker d-flex gap-2">
                            <MudCheckBox T="bool" Color="Color.Error" Label="1"/>
                            <MudCheckBox T="bool" Color="Color.Error" Label="2"/>
                            <MudCheckBox T="bool" Color="Color.Error" Label="3"/>
                        </div>
                    </div>

                    <div class="equipment-section">
                        <h4 class="zone-subtitle">Ausrüstung</h4>
                        <ul class="equipment-list">
                            <li>Langschwert (1W6+4)</li>
                            <li>Kettenhemd (RS 4)</li>
                            <li>Heiltrank (3)</li>
                        </ul>
                    </div>
                </div>

                <div class="action-grid mt-6">
                    <button class="dsa-btn primary-action">Attacke</button>
                    <button class="dsa-btn primary-action">Parade</button>
                    <button class="dsa-btn secondary-action">Ausweichen</button>
                </div>
            </div>

            <div class="combat-zone settings-panel mt-4">
                <h2 class="zone-title">Kampfproben</h2>
                <div class="d-flex align-center gap-4 mt-3">

                    <div class="search-wrapper flex-grow-1">
                        <img src="icons/search.svg" class="search-icon" alt=""/>
                        <input type="text"
                               class="search-input"
                               placeholder="Manöver, Zauber, Artefakte..."
                               @bind="SearchTerm"
                               @bind:event="oninput"
                               @onfocus="() => _isDropdownOpen = true"
                               @onblur="HandleBlur"/>

                        @if (_isDropdownOpen && FilteredManeuvers.Any())
                        {
                            <div class="search-dropdown">
                                @foreach (var maneuver in FilteredManeuvers)
                                {
                                    <div class="dropdown-item" @onclick="() => SelectManeuver(maneuver)">
                                        @maneuver
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="ms-auto">
                        <ModifierPill Value="0" />
                    </div>
                </div>
            </div>
        </div>

        <div class="combat-zone right-panel">
            <h2 class="zone-title">Kampfverlauf</h2>
            <div class="log-entries">
            </div>
        </div>
    </div>
</div>
