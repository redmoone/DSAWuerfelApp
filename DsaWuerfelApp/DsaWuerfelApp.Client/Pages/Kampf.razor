@page "/kampf"
@using DsaWuerfelApp.Client.Components
@using DsaWuerfelApp.Client.Components.Combat
@using DsaWuerfelApp.Client.Services
@using DsaWuerfelApp.Shared
@attribute [Authorize]

<div class="combat-page">
    <div class="combat-shell">
        <section class="combat-status-surface panel-surface" aria-label="Kampfstatus">
            @if (CanSwitchCombatView)
            {
                <div class="combat-view-switch" aria-label="Kampfansicht">
                    <span class="combat-view-switch-current">@(IsMasterView ? "Meisteransicht" : "Spieleransicht")</span>
                    <UiButton Size="compact" OnClick="ToggleCombatView">
                        @(IsMasterView ? "Spieleransicht öffnen" : "Meisteransicht öffnen")
                    </UiButton>
                </div>
            }

            @if (NeedsOwnHeroPlaceholder)
            {
                <div class="combat-hero-placeholder" role="status">
                    <p class="combat-kicker">@(IsMasterView ? "Meisteransicht" : "Spieleransicht")</p>
                    <strong>@(SessionCombat is null ? "Sessionstand wird geladen" : "Kein eigener Held in dieser Session")</strong>
                    <span>
                        @(SessionCombat is null
                            ? "Die Kampfdaten werden geladen."
                            : IsMasterView
                                ? "Die Sessionverwaltung bleibt verfügbar; für eigene Kampfaktionen muss ein eigener Held ausgewählt sein."
                                : "Wähle in der Session einen eigenen Helden, um dessen Kampfwerte und Aktionen zu sehen.")
                    </span>
                </div>
            }
            else
            {
                <CombatStatusPanel HeroName="@HeroDisplayName"
                                   SessionName="@SessionState.ActiveSession?.Name"
                                   Profile="@Profile"
                                   IsLoading="@ProfileLoading"
                                   ErrorMessage="@ProfileError"
                                   CurrentLeP="@CurrentLeP"
                                   CurrentAuP="@CurrentAuP"
                                   CurrentAeP="@CurrentAeP"
                                   CurrentKeP="@CurrentKeP"
                                   CurrentInitiative="@CurrentInitiative"
                                   IsCombatStarted="@IsCombatStarted"
                                   CanStartCombat="@(!IsCombatStarted)"
                                   StartCombatRequested="InitializeCombatStateAsync"
                                   ResourceEditRequested="OpenResourceDrawer"
                                   ResourceValueChangedRequested="HandleResourceValueChanged"
                                   InitiativeValueChangedRequested="HandleInitiativeChanged"
                                   WoundsRequested="() => SetArea(CombatArea.Zonen)"
                                   CanUndo="@CanUndoCombat"
                                   UndoRequested="UndoLastChangeAsync"
                                   PersistenceWarning="@CombatState.PersistenceError"
                                   Wounds="@Wounds"
                                   Effects="@Effects"
                                   IsMutationBusy="@_valueMutationBusy" />
            }
        </section>

        <div class="combat-content-grid">
            <div class="combat-work-area">
        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <p class="combat-notice" role="status">@_notice</p>
        }

        <nav class="combat-tabs" role="tablist" aria-label="Kampfflächen">
            <UiButton Variant="tab"
                      Active="@(ActiveArea == CombatArea.Kampf)"
                      role="tab"
                      aria-selected="@(ActiveArea == CombatArea.Kampf)"
                      aria-controls="combat-tab-kampf"
                      OnClick="() => SetArea(CombatArea.Kampf)">
                Kampf
            </UiButton>
            <UiButton Variant="tab"
                      Active="@(ActiveArea == CombatArea.Zonen)"
                      role="tab"
                      aria-selected="@(ActiveArea == CombatArea.Zonen)"
                      aria-controls="combat-tab-ruestung"
                      OnClick="() => SetArea(CombatArea.Zonen)">
                Rüstung &amp; Wunden
            </UiButton>
            <UiButton Variant="tab"
                      Active="@(ActiveArea == CombatArea.Runde)"
                      role="tab"
                      aria-selected="@(ActiveArea == CombatArea.Runde)"
                      aria-controls="combat-tab-runde"
                      OnClick="() => SetArea(CombatArea.Runde)">
                Rundenübersicht
            </UiButton>
            <UiButton Variant="tab"
                      Active="@(ActiveArea == CombatArea.Eigenschaften)"
                      role="tab"
                      aria-selected="@(ActiveArea == CombatArea.Eigenschaften)"
                      aria-controls="combat-tab-eigenschaften"
                      OnClick="() => SetArea(CombatArea.Eigenschaften)">
                Eigenschaften
            </UiButton>
        </nav>

        <main class="combat-main-area">
            @if (ActiveArea is CombatArea.Kampf or CombatArea.Eigenschaften)
            {
                <section id="@(ActiveArea == CombatArea.Kampf ? "combat-tab-kampf" : "combat-tab-eigenschaften")"
                         class="combat-tab-panel panel-surface"
                         role="tabpanel"
                         aria-label="@(ActiveArea == CombatArea.Kampf ? "Kampf" : "Eigenschaften")">
                    @if (NeedsOwnHeroPlaceholder)
                    {
                        <div class="combat-hero-placeholder combat-hero-placeholder--workspace" role="status">
                            <strong>Keine eigenen Kampfaktionen verfügbar</strong>
                            <span>Dieser Bereich zeigt erst Werte und Aktionen des eigenen Helden, wenn er der Session zugeordnet ist.</span>
                        </div>
                    }
                    else
                    {
                        <CombatActionPanel Sets="@Sets"
                                           IsLoading="@ProfileLoading"
                                           SelectedSetId="@SelectedSetId"
                                           SetSelected="HandleSetSelected"
                                           IsSessionCombat="@IsSessionCombat"
                                           AttributeMode="@IsAttributeMode"
                                           Weapons="@Weapons"
                                           SelectedWeaponId="@SelectedWeaponId"
                                           WeaponSelected="HandleWeaponSelected"
                                           SelectedAction="@SelectedAction"
                                           ActionSelected="HandleActionSelected"
                                           Actions="@Actions"
                                           Maneuvers="@Maneuvers"
                                           SelectedProbe="@SelectedProbe"
                                           ProbeSelected="HandleProbeSelected"
                                           Attributes="@Attributes"
                                           SelectedAttributes="@SelectedAttributes"
                                           AttributeSelected="HandleAttributeSelected"
                                           AttributeRemoved="HandleAttributeRemoved"
                                           Modifier="@Modifier"
                                           ModifierChanged="HandleModifierChanged"
                                           RollText="@RollText"
                                           RollTextChanged="HandleRollTextChanged"
                                           ResetRequested="ResetAction"
                                           RollRequested="HandleRollRequested"
                                           CanRoll="@CanRoll"
                                           IsBusy="@_rollBusy"
                                           BaseTarget="@GetActionBaseValue()"
                                           EffectiveTarget="@EffectiveTarget"
                                           Facing="@Facing"
                                           FacingChanged="HandleFacingChanged"
                                           ActiveExchange="@SessionCombat?.ActiveExchange"
                                           ActiveExchangeAttackerName="@ActiveExchangeAttackerName"
                                           ActiveExchangeTargetName="@ActiveExchangeTargetName"
                                           CanRespondToExchange="@CanRespondToExchange"
                                           CanAdvanceExchange="@CanAdvanceExchange"
                                           HasExchangeZone="@HasExchangeZone"
                                           ExchangeActionRequested="HandleExchangeActionAsync"
                                           CanConsumeReaction="@CanConsumeReaction"
                                           ConsumeReactionRequested="ConsumeReactionFromResultAsync"
                                           ResultDiceSides="@ResultDiceSides"
                                           ResultDiceValues="@ResultDiceValues"
                                           ResultVersion="@ResultVersion" />
                    }
                </section>
            }
            else if (ActiveArea == CombatArea.Zonen)
            {
                <section id="combat-tab-ruestung" class="combat-tab-panel panel-surface" role="tabpanel" aria-label="Rüstung und Wunden">
                    @if (NeedsOwnHeroPlaceholder)
                    {
                        <div class="combat-hero-placeholder combat-hero-placeholder--workspace" role="status">
                            <strong>Keine eigene Rüstung oder Wunden verfügbar</strong>
                            <span>Die Zonenansicht gehört immer zum eigenen Helden der aktuellen Session.</span>
                        </div>
                    }
                    else
                    {
                        <CombatBodyPanel SelectedSet="@SelectedSet"
                                         Facing="@Facing"
                                         FacingChanged="HandleFacingChanged"
                                         SelectedZone="@SelectedZone"
                                         ZoneSelected="HandleZoneSelected"
                                         Wounds="@Wounds"
                                         WoundChanged="HandleWoundChanged"
                                         IsBusy="@_valueMutationBusy" />
                    }
                </section>
            }
            else
            {
                <section id="combat-tab-runde" class="combat-tab-panel panel-surface" role="tabpanel" aria-labelledby="round-title">
                    <div class="combat-section-heading">
                        <div>
                            <p class="combat-kicker">Initiative</p>
                            <h2 id="round-title">Rundenübersicht</h2>
                        </div>
                        <span class="combat-round-state">@(IsSessionCombat ? "Gemeinsamer Sessionstand" : "Solo-Kampf")</span>
                    </div>

                    <div class="combat-initiative-summary">
                        @if (IsSessionCombat && SessionCombat is { } sessionCombat)
                        {
                            <strong>Runde @sessionCombat.Round</strong>
                            <span>@(sessionCombat.IsStarted ? "Gemeinsamer Sessionstand" : "Noch kein Startwurf") · Revision @sessionCombat.Revision</span>
                        }
                        else
                        {
                            <strong>@(CurrentInitiative.HasValue ? $"INI {CurrentInitiative}" : "Noch kein laufender INI-Wert")</strong>
                            <span>Basis-INI: @(SelectedSet?.Initiative?.ToString() ?? "—") · Startwurf @GetInitiativeDiceLabel()</span>
                        }
                    </div>

                    @if (!IsSessionCombat && HasRuntimeInitiativeNotes())
                    {
                        <p class="combat-initiative-runtime">@GetRuntimeInitiativeSummary()</p>
                    }

                    @if (!IsSessionCombat)
                    {
                        <div class="combat-solo-round-card">
                            <div>
                                <span class="combat-turn-label">Aktiver Held</span>
                                <strong>@HeroDisplayName</strong>
                            </div>
                            <span class="combat-initiative-readonly">@(CurrentInitiative.HasValue ? $"INI {CurrentInitiative}" : "INI —")</span>
                        </div>
                    }
                    else if (InitiativeParticipants.Count == 0)
                    {
                        <p class="combat-side-empty">Aktive Helden erscheinen nach ihrem ersten Initiativewurf.</p>
                    }
                    else
                    {
                        <div class="combat-initiative-list" aria-label="Gemeinsame Initiative">
                            @foreach (var participant in InitiativeParticipants)
                            {
                                <div class="combat-initiative-row @(IsCurrentParticipant(participant) ? "current" : string.Empty) @(participant.CurrentInitiative.HasValue ? string.Empty : "unknown") @GetParticipantTurnClass(participant)">
                                    <div class="combat-initiative-person">
                                        <span class="combat-turn-label">@GetParticipantTurnLabel(participant)</span>
                                        <strong>@participant.Name</strong>
                                        <span>@(string.IsNullOrWhiteSpace(participant.Affiliation) ? participant.Kind == CombatParticipantKind.Hero ? "Held" : "Gegner" : participant.Affiliation)</span>
                                    </div>
                                    @if (OwnSessionParticipant?.Id == participant.Id)
                                    {
                                        <span class="combat-initiative-readonly">@(participant.CurrentInitiative.HasValue ? $"INI {participant.CurrentInitiative}" : "INI —")</span>
                                    }
                                    else if (CanEditParticipantInitiative(participant))
                                    {
                                        <NumberControl Label="INI"
                                                       Value="@participant.CurrentInitiative"
                                                       ValueChanged="value => HandleParticipantInitiativeChanged(participant, value)"
                                                       AllowEmpty="true"
                                                       DisableStepsWhenEmpty="true"
                                                       ShowValidationMessage="true"
                                                       Disabled="@_valueMutationBusy" />
                                    }
                                    else
                                    {
                                        <span class="combat-initiative-readonly">@(participant.CurrentInitiative.HasValue ? $"INI {participant.CurrentInitiative}" : "INI —")</span>
                                    }
                                    <div class="combat-initiative-flags">
                                        <span class="combat-action-flag @(participant.ActionAvailable ? "available" : string.Empty)">@(participant.ActionAvailable ? "A" : "A✓")</span>
                                        @if (CanManageParticipantControls(participant))
                                        {
                                            <UiButton Size="compact"
                                                      Disabled="@(!participant.ReactionAvailable)"
                                                      OnClick="() => ConsumeReactionAsync(participant)">
                                                @(participant.ReactionAvailable ? "Reaktion" : "PA verbraucht")
                                            </UiButton>
                                        }
                                        else
                                        {
                                            <span class="combat-action-flag @(participant.ReactionAvailable ? "available" : string.Empty)">
                                                @(participant.ReactionAvailable ? "Reaktion frei" : "PA verbraucht")
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(participant.Announcement))
                                    {
                                        <span class="combat-initiative-announcement">Ansage: @participant.Announcement</span>
                                    }
                                    @if (HasRuntimeInitiativeState(participant))
                                    {
                                        <span class="combat-initiative-runtime" title="@FormatRuntimeNotes(participant.InitiativeRuntimeNotes)">
                                            Laufend @FormatSigned(participant.InitiativeRuntimeModifier)
                                        </span>
                                    }
                                    @foreach (var action in GetParticipantActions(participant.Id))
                                    {
                                        <div class="combat-action-entry @(action.State.ToString().ToLowerInvariant())">
                                            <span>@action.Label · @(action.ActionCost == 1 ? "1 Aktion" : $"{action.ActionCost} Aktionen")</span>
                                            @if (action.State == CombatActionEntryState.Open && CanManageParticipantControls(participant))
                                            {
                                                <span class="combat-action-entry-buttons">
                                                    @if (IsOrientationAction(action) && action.RequiresCheck)
                                                    {
                                                        <UiButton Size="compact" OnClick="() => ResolveOrientationAsync(action)">IN-Probe würfeln</UiButton>
                                                    }
                                                    else
                                                    {
                                                        <UiButton Size="compact" OnClick="() => CompleteActionAsync(action)">@(IsOrientationAction(action) ? "Orientieren abschließen" : "Abschließen")</UiButton>
                                                    }
                                                <UiButton Size="compact" OnClick="() => HoldActionAsync(action)">Warten</UiButton>
                                                </span>
                                            }
                                            else if (action.State == CombatActionEntryState.Held && CanManageParticipantControls(participant))
                                            {
                                                <UiButton Size="compact" OnClick="() => ExecuteHeldActionAsync(action)">Jetzt ausführen</UiButton>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="combat-initiative-actions">
                        @if (IsMasterView)
                        {
                            <UiButton Disabled="@(!(SessionCombat?.IsStarted ?? false))" OnClick="NewRoundAsync">Neue Runde</UiButton>
                        }
                        @if (CanManageOwnSessionParticipant)
                        {
                            <UiButton Disabled="@(OwnSessionParticipant?.CurrentInitiative is null)" OnClick="OpenOrientationDrawer">Orientieren</UiButton>
                        }
                        @if (IsSessionCombat && IsMasterView)
                        {
                            <UiButton OnClick="OpenAnnouncementDrawer">Rundenansage</UiButton>
                            <UiButton OnClick="OpenOpponentDrawer">Gegner hinzufügen</UiButton>
                        }
                    </div>
                </section>
            }
        </main>
            </div>

            <div class="combat-initiative-column">
                <CombatInitiativeOverview IsSessionCombat="@IsSessionCombat"
                                          SessionCombat="@SessionCombat"
                                          HeroName="@HeroDisplayName"
                                          CurrentInitiative="@CurrentInitiative"
                                          InitiativeBase="@InitiativeBase"
                                          Participants="@InitiativeParticipants"
                                          TurnLabel="GetParticipantTurnLabel"
                                          IsCurrentParticipant="IsCurrentParticipant"
                                          ParticipantStatus="GetParticipantStatus"
                                          ShowTargetSelection="@CanSelectCombatTarget"
                                          SelectedTargetParticipantId="@SelectedTargetParticipantId"
                                          CanSelectTarget="IsTargetSelectable"
                                          TargetSelected="HandleTargetSelected"
                                          CanRollParticipantInitiative="CanRollParticipantInitiative"
                                          RollInitiativeRequested="RollParticipantInitiativeAsync"
                                          CanRemoveOpponent="CanRemoveOpponent"
                                          RemoveOpponentRequested="RemoveOpponentAsync"
                                          CanManageParticipantControls="CanManageParticipantControls"
                                          ParticipantActions="participant => GetParticipantActions(participant.Id)"
                                          IsOrientationAction="IsOrientationAction"
                                          ConsumeReactionRequested="ConsumeReactionAsync"
                                          CompleteActionRequested="CompleteActionAsync"
                                          HoldActionRequested="HoldActionAsync"
                                          ExecuteHeldActionRequested="ExecuteHeldActionAsync"
                                          ResolveOrientationRequested="ResolveOrientationAsync" />

                <section class="combat-history-sidebar" aria-labelledby="combat-history-title">
                    <div class="combat-history-heading">
                        <h2 id="combat-history-title">Verlauf</h2>
                        <span>@History.Count</span>
                    </div>
                    <RollHistory Entries="@History" EntrySelected="HandleHistorySelected" />
                </section>
            </div>
        </div>
    </div>
</div>

<CombatDetailsDrawer Open="@(_drawer != CombatDrawer.None)" Title="@DrawerTitle" CloseRequested="CloseDrawer">
    @if (_drawer == CombatDrawer.Resource && _resourceDrawerKind is { } resource)
    {
        <div class="combat-drawer-form">
            <NumberControl Label="@GetResourceLabel(resource)"
                           Value="@_resourceDraft"
                           ValueChanged="HandleResourceDraftChanged"
                           Minimum="@GetResourceMinimum(resource)"
                           StepMaximum="@GetResourceMaximum(resource)"
                           AllowEmpty="true"
                           ShowValidationMessage="true" />
            <div class="combat-drawer-actions">
                <UiButton Variant="primary" OnClick="ApplyResourceDrawerAsync">Speichern</UiButton>
                <UiButton OnClick="CloseDrawer">Abbrechen</UiButton>
            </div>
        </div>
    }
    else if (_drawer == CombatDrawer.Orientation)
    {
        <div class="combat-drawer-form">
            <p class="combat-drawer-lead">Orientieren ist erst nach dem ersten INI-Wurf möglich und braucht eine ungestörte Beobachtungsphase.</p>
            @if (Profile is { } orientationProfile)
            {
                <p class="combat-drawer-hint">
                    Aufmerksamkeit: @(orientationProfile.HasAttention ? "vorhanden · 1 Aktion · keine IN-Probe" : "nicht vorhanden · 2 Aktionen · IN-Probe erforderlich").
                </p>
                @if (!orientationProfile.HasAttention)
                {
                    <NumberControl Label="Kriegskunst-Erleichterung"
                                   Value="@_orientationReliefDraft"
                                   ValueChanged="HandleOrientationReliefChanged"
                                   Minimum="0"
                                   Maximum="20" />
                    <p class="combat-drawer-hint">Kriegskunst-TaW: @(orientationProfile.KriegskunstValue?.ToString() ?? "nicht vorhanden"). Je zwei TaW-Punkte ergeben eine Erleichterung von 1.</p>
                }
            }
            <label class="combat-drawer-check">
                <input type="checkbox" checked="@_orientationUninterruptedDraft" @onchange="HandleOrientationUninterruptedChanged" />
                <span>Ungestört möglich</span>
            </label>
            <div class="combat-drawer-actions">
                <UiButton Variant="primary" Disabled="@(OwnSessionParticipant?.CurrentInitiative is null)" OnClick="ApplyOrientationAsync">Handlung anlegen</UiButton>
                <UiButton OnClick="CloseDrawer">Abbrechen</UiButton>
            </div>
        </div>
    }
    else if (_drawer == CombatDrawer.Participant)
    {
        <div class="combat-drawer-form">
            @if (_participantDrawerMode == CombatParticipantDrawerMode.Opponent)
            {
                <p class="combat-drawer-lead">DSA-4.1-Profil wählen. Werte aus dem Katalog werden nicht erneut eingegeben.</p>
                @if (_enemyCatalogLoading)
                {
                    <p class="combat-drawer-hint">Gegnerkatalog wird geladen …</p>
                }
                else
                {
                    <label class="combat-drawer-field">
                        <span>Gegnerprofil</span>
                        <select class="ui-select combat-enemy-select"
                                value="@(_selectedEnemyId ?? string.Empty)"
                                @onchange="HandleEnemySelectionChanged">
                            <option value="">Profil auswählen …</option>
                            <option value="@ManualOpponentSelection">Manuell ohne Katalog</option>
                            @foreach (var enemy in _enemyCatalog.OrderBy(enemy => enemy.Name, StringComparer.OrdinalIgnoreCase))
                            {
                                <option value="@enemy.Id">@enemy.Name</option>
                            }
                        </select>
                    </label>
                }

                @if (SelectedEnemyCatalogEntry is { } selectedEnemy)
                {
                    <div class="combat-enemy-catalog-summary">
                        <strong>@selectedEnemy.Name</strong>
                        <span>@GetSelectedEnemyInitiativeLabel() · @GetSelectedEnemyLePLabel() · @GetSelectedEnemyDefenseLabel()</span>
                        <small>@GetSelectedEnemyReadinessLabel()</small>
                        <small>@GetSelectedEnemySourceLabel()</small>
                    </div>

                    @if (selectedEnemy.CombatVariants.Length > 0)
                    {
                        <label class="combat-drawer-field">
                            <span>Erfahrungsstufe</span>
                            <select class="ui-select" value="@(_selectedEnemyVariantId ?? string.Empty)" @onchange="HandleEnemyVariantChanged">
                                <option value="">Variante auswählen …</option>
                                @foreach (var variant in selectedEnemy.CombatVariants)
                                {
                                    <option value="@variant.Id">@variant.Label</option>
                                }
                            </select>
                        </label>
                    }

                    @if (selectedEnemy.Attacks.Length > 1)
                    {
                        <label class="combat-drawer-field">
                            <span>Angriff</span>
                            <select class="ui-select" value="@(_selectedEnemyAttackId ?? string.Empty)" @onchange="HandleEnemyAttackChanged">
                                <option value="">Angriff auswählen …</option>
                                @foreach (var attack in selectedEnemy.Attacks)
                                {
                                    <option value="@attack.Id">@GetEnemyAttackLabel(attack)</option>
                                }
                            </select>
                        </label>
                    }

                    @if (selectedEnemy.Equipment is { SelectionRequired: true } equipment)
                    {
                        <label class="combat-drawer-field">
                            <span>Waffe</span>
                            <select class="ui-select" value="@(_selectedEnemyWeaponOption ?? string.Empty)" @onchange="HandleEnemyWeaponChanged">
                                <option value="">Waffe auswählen …</option>
                                @foreach (var weapon in equipment.WeaponOptions)
                                {
                                    <option value="@weapon">@weapon</option>
                                }
                            </select>
                        </label>
                        <label class="combat-drawer-field">
                            <span>Rüstung</span>
                            <select class="ui-select" value="@(_selectedEnemyArmorOption ?? string.Empty)" @onchange="HandleEnemyArmorChanged">
                                <option value="">Rüstung auswählen …</option>
                                @foreach (var armor in equipment.ArmorOptions)
                                {
                                    <option value="@armor">@armor</option>
                                }
                            </select>
                        </label>
                        <p class="combat-drawer-hint">Der Katalog enthält für diese Ausrüstung keine TP-/RS-Werte. Der Gegner bleibt bis zur Meisterentscheidung unvollständig.</p>
                    }

                    @if (SelectedEnemyLePRange is { Min: { } min, Max: { } max })
                    {
                        <NumberControl Label="LeP festlegen"
                                       Value="@_selectedEnemyLeP"
                                       ValueChanged="HandleEnemyLePChanged"
                                       Minimum="@min"
                                       Maximum="@max"
                                       AllowEmpty="true"
                                       ShowValidationMessage="true" />
                        <p class="combat-drawer-hint">Quelle: LeP @min–@max; vor dem Kampfbeginn ist eine Meisterentscheidung erforderlich.</p>
                    }
                }
                else if (IsManualOpponentSelection)
                {
                    <label class="combat-drawer-field">
                        <span>Name</span>
                        <input value="@_opponentNameDraft" @oninput="eventArgs => HandleOpponentNameChanged(eventArgs.Value?.ToString() ?? string.Empty)" />
                    </label>
                    <NumberControl Label="INI-Basis" Value="@_opponentInitiativeBaseDraft" ValueChanged="HandleOpponentInitiativeBaseChanged" AllowEmpty="true" />
                    <NumberControl Label="Aktuelle INI" Value="@_opponentInitiativeDraft" ValueChanged="HandleOpponentInitiativeChanged" AllowEmpty="true" />
                }
                else if (!_enemyCatalogLoading)
                {
                    <p class="combat-drawer-hint">Ein Profil auswählen oder die manuelle Erfassung öffnen.</p>
                }

                <label class="combat-drawer-field">
                    <span>Zugehörigkeit</span>
                    <input value="@_opponentAffiliationDraft" @oninput="eventArgs => HandleOpponentAffiliationChanged(eventArgs.Value?.ToString() ?? string.Empty)" />
                </label>
            }
            else
            {
                <p class="combat-drawer-lead">Ansage und Ausführung bleiben getrennt. Ein normaler Kampfwurf braucht keine Ansage.</p>
                <label class="combat-drawer-field">
                    <span>Ansage</span>
                    <input value="@_announcementDraft" @oninput="eventArgs => HandleAnnouncementChanged(eventArgs.Value?.ToString() ?? string.Empty)" />
                </label>
            }
            <div class="combat-drawer-actions">
                <UiButton Variant="primary" Disabled="@(_participantDrawerMode == CombatParticipantDrawerMode.Opponent && !CanApplyOpponentDrawer)" OnClick="ApplyParticipantDrawerAsync">Hinzufügen</UiButton>
                <UiButton OnClick="CloseDrawer">Abbrechen</UiButton>
            </div>
        </div>
    }
</CombatDetailsDrawer>

@if (_selectedHistoryEntry is not null)
{
    <WuerfelInformationPanel SelectedHistoryEntry="@_selectedHistoryEntry"
                             ShowProbeInfoDetails="true"
                             CloseRequested="CloseHistoryDetails" />
}
