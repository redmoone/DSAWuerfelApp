@page "/kampf"
@using DsaWuerfelApp.Client.Components
@using DsaWuerfelApp.Client.Components.Combat
@using DsaWuerfelApp.Shared
@attribute [Authorize]

<div class="combat-page">
    <div class="combat-shell">
        <header class="combat-header panel-surface">
            <div class="combat-header-copy">
                <p class="combat-kicker">Kampf</p>
                <h1>@HeroDisplayName</h1>
                <p class="combat-subtitle">
                    @(string.IsNullOrWhiteSpace(SessionState.ActiveSession?.Name)
                        ? "Kampfoberfläche für den aktiven Helden"
                        : $"Session · {SessionState.ActiveSession.Name}")
                </p>
            </div>
            <div class="combat-header-actions">
                <a class="combat-header-button" href="#combat-body-panel">Körperzonen</a>
                <button type="button"
                        class="combat-header-button primary"
                        disabled="@(!HasCombatContext)"
                        title="Treffererfassung wird mit dem laufenden Kampfzustand verfügbar"
                        @onclick="OpenHitCapture">
                    Treffer erfassen
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <p class="combat-notice" role="status">@_notice</p>
        }

        <section class="combat-status-surface panel-surface">
            <CombatStatusPanel HeroName="@HeroDisplayName"
                               SessionName="@SessionState.ActiveSession?.Name"
                               Profile="@Profile"
                               IsLoading="@ProfileLoading"
                               ErrorMessage="@ProfileError"
                               SelectedSet="@SelectedSet"
                               CurrentLeP="@CurrentLeP"
                               CurrentAuP="@CurrentAuP"
                               CurrentInitiative="@CurrentInitiative"
                               IsCombatStarted="@CombatState.IsStarted"
                               CanStartCombat="@HasCombatContext"
                               StartCombatRequested="StartCombatAsync"
                               CanUndo="@CombatState.CanUndo"
                               UndoRequested="UndoLastChangeAsync"
                               PersistenceWarning="@CombatState.PersistenceError"
                               Wounds="@Wounds"
                               Effects="@Effects" />
        </section>

        @if (_hitCaptureOpen)
        {
            <CombatHitCapturePanel SelectedZone="@_hitZone"
                                   SelectedZoneChanged="HandleHitZoneChanged"
                                   LePLossText="@_hitLePLossText"
                                   LePLossTextChanged="HandleHitLePLossChanged"
                                   NewWounds="@_hitWounds"
                                   NewWoundsChanged="HandleHitWoundsChanged"
                                   Note="@_hitNote"
                                   NoteChanged="HandleHitNoteChanged"
                                   CurrentLeP="@CurrentLeP"
                                   PreviewLeP="@HitPreviewLeP"
                                   CurrentWounds="@CurrentHitWounds"
                                   CanApply="@CanApplyHit"
                                   IsBusy="@_hitBusy"
                                   ApplyRequested="ApplyHitAsync"
                                   CancelRequested="CloseHitCapture" />
        }

        <main class="combat-main panel-surface">
            <CombatActionPanel Sets="@Sets"
                               IsLoading="@ProfileLoading"
                               SelectedSetId="@SelectedSetId"
                               SetSelected="HandleSetSelected"
                               Weapons="@Weapons"
                               SelectedWeaponId="@SelectedWeaponId"
                               WeaponSelected="HandleWeaponSelected"
                               SelectedAction="@SelectedAction"
                               ActionSelected="HandleActionSelected"
                               Actions="@Actions"
                               Maneuvers="@Maneuvers"
                               SelectedProbe="@SelectedProbe"
                               ProbeSelected="HandleProbeSelected"
                               Attributes="@Attributes"
                               SelectedAttribute="@SelectedAttribute"
                               AttributeSelected="HandleAttributeSelected"
                               Modifier="@Modifier"
                               ModifierChanged="HandleModifierChanged"
                               RollText="@RollText"
                               RollTextChanged="HandleRollTextChanged"
                               ResetRequested="ResetAction"
                               RollRequested="HandleRollRequested" />

            <CombatBodyPanel SelectedSet="@SelectedSet"
                             Facing="@Facing"
                             FacingChanged="HandleFacingChanged"
                             SelectedZone="@SelectedZone"
                             ZoneSelected="HandleZoneSelected"
                             Wounds="@Wounds" />
        </main>

        <aside class="combat-side">
            <section class="combat-info-surface panel-surface" aria-labelledby="combat-info-title">
                <WuerfelInformationPanel CustomTitle="Kampfinformation"
                                         CustomAriaLabel="Kampfinformation"
                                         CustomSummary="@CombatInformationSummary">
                    <CustomContent>
                        <div class="combat-information-content">
                            <div class="combat-info-row">
                                <span>Auswahl</span>
                                <strong>@SelectionSummary</strong>
                            </div>
                            <div class="combat-info-row">
                                <span>Datenstatus</span>
                                <strong>@ProfileStatus</strong>
                            </div>
                            <div class="combat-info-row">
                                <span>Regelanbindung</span>
                                <strong>Kampfwürfe noch nicht angebunden</strong>
                            </div>
                            @if (SelectedWeapon is not null)
                            {
                                <div class="combat-info-row">
                                    <span>Waffe / Abwehr</span>
                                    <strong>@SelectedWeapon.Name Nr. @SelectedWeapon.Number · @GetWeaponCategoryLabel(SelectedWeapon.Category)</strong>
                                </div>
                                <div class="combat-info-row">
                                    <span>Quellwerte</span>
                                    <strong>@GetWeaponPrimaryValues(SelectedWeapon) · TP @GetWeaponDamage(SelectedWeapon)</strong>
                                </div>
                            }
                            @if (SelectedSpecialization is not null)
                            {
                                <div class="combat-info-row">
                                    <span>Sonderfertigkeit</span>
                                    <strong>@SelectedSpecialization.Name · @(SelectedSpecialization.IsLearned ? "gelernt" : "vergünstigt")</strong>
                                </div>
                                <div class="combat-info-row">
                                    <span>Kategorien</span>
                                    <strong>@(SelectedSpecialization.Categories.Length == 0 ? "Keine Kategorien exportiert" : string.Join(" · ", SelectedSpecialization.Categories))</strong>
                                </div>
                            }
                            <p class="combat-info-note">Importierte Werte werden angezeigt. Diese Oberfläche berechnet keine Treffer, TP oder Wundfolgen.</p>
                        </div>
                    </CustomContent>
                </WuerfelInformationPanel>
            </section>

            <section class="combat-initiative-surface panel-surface" aria-labelledby="combat-initiative-title">
                <div class="combat-side-heading">
                    <div>
                        <p class="combat-kicker">Initiative</p>
                        <h2 id="combat-initiative-title">Rundenübersicht</h2>
                    </div>
                    <span class="combat-side-meta">@(CurrentInitiative.HasValue ? $"INI {CurrentInitiative}" : "nicht geführt")</span>
                </div>
                @if (CombatState.IsStarted)
                {
                    <div class="combat-initiative-editor">
                        <TextPill Value="@_initiativeText"
                                  ValueChanged="HandleInitiativeTextChanged"
                                  InputType="number"
                                  Label="INI"
                                  Placeholder="aktuelle INI" />
                        <button type="button" class="combat-header-button" @onclick="ApplyInitiativeAsync">INI setzen</button>
                    </div>
                }
                @if (InitiativeEntries.Count == 0)
                {
                    <p class="combat-side-empty">Noch keine Teilnehmer oder laufende Initiative vorhanden.</p>
                }
                else
                {
                    <div class="combat-initiative-list">
                        @foreach (var entry in InitiativeEntries)
                        {
                            <div class="combat-initiative-row">
                                <strong>@entry.Name</strong>
                                <span>@(entry.Initiative.HasValue ? $"INI {entry.Initiative}" : "nicht geführt")</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="combat-history-surface panel-surface" aria-labelledby="combat-history-title">
                <div class="combat-side-heading">
                    <div>
                        <p class="combat-kicker">Verlauf</p>
                        <h2 id="combat-history-title">Würfelhistorie</h2>
                    </div>
                    <span class="combat-side-meta">@WuerfelState.Current.History.Count Einträge</span>
                </div>
                <RollHistory Entries="@WuerfelState.Current.History" EntrySelected="HandleHistorySelected" />
            </section>
        </aside>
    </div>
</div>
