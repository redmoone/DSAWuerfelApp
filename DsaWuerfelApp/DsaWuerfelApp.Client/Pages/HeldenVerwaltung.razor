@page "/helden-verwaltung"

<div class="helden-verwaltung-page">
    <div class="helden-verwaltung-container">
        <h2 class="page-title">Helden Verwaltung</h2>

        <div class="upload-section">
            <label class="drop-zone @DragClass"
                   @ref="DropZoneElement"
                   @ondragenter="SetDragClass"
                   @ondragleave="ClearDragClass"
                   @ondragover="SetDragClass"
                   @ondragenter:preventDefault="true"
                   @ondragover:preventDefault="true"
                   @ondragleave:preventDefault="true">

                <div class="file-input-host">
                    <InputFile OnChange="LoadFiles" multiple accept=".xml" class="file-input"/>
                </div>
                <p class="drop-zone-text">XML-Dateien hierhin ziehen oder klicken zum Auswählen</p>
            </label>

            @if (SelectedFiles.Any())
            {
                <div class="selected-files">
                    <ul class="selected-files-list">
                        @foreach (var file in SelectedFiles)
                        {
                            <li>@file.Name</li>
                        }
                    </ul>
                    <button class="btn-upload" @onclick="UploadFilesAsync">Hochladen</button>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert-error">
                @ErrorMessage
            </div>
        }

        @if (Heroes.Any())
        {
            <div class="hero-list">
                @foreach (var hero in Heroes)
                {
                    <div class="hero-card @(hero == SelectedHero ? "selected" : "")"
                         @onclick="() => SelectHero(hero)">
                        <div class="hero-info">
                            <span class="hero-name">@hero.Name</span>
                        </div>
                        <div class="hero-actions">
                            <button class="btn-activate @(hero.IsActive ? "is-active" : "")"
                                    @onclick="() => SetActiveHeroAsync(hero)"
                                    @onclick:stopPropagation>
                                @(hero.IsActive ? "Aktiv" : "Aktivieren")
                            </button>
                            <button class="btn-delete"
                                    @onclick="() => RemoveHeroAsync(hero)"
                                    @onclick:stopPropagation>
                                Entfernen
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
