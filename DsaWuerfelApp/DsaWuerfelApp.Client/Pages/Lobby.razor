@page "/"
@using DsaWuerfelApp.Client.Components
@attribute [AllowAnonymous]

<div class="lobby-page">
    <div class="lobby-shell @(IsAuthenticated ? "authenticated" : "anonymous")">
        <header class="lobby-header">
            <div class="lobby-heading">
                <p class="hero-eyebrow">DSA Würfelrunde</p>
                <h1>Gamesessions</h1>
            </div>

            @if (IsAuthenticated && CurrentUser is not null)
            {
                <div class="lobby-account">
                    <span class="lobby-account-email">@CurrentUser.Email</span>
                    <button type="button"
                            class="session-btn secondary-btn"
                            @onclick="Logout"
                            disabled="@_isSigningOut"
                            aria-busy="@(_isSigningOut ? "true" : "false")">
                        @(_isSigningOut ? "Abmelden …" : "Abmelden")
                    </button>
                </div>
            }
        </header>

        @if (!AuthState.IsLoaded)
        {
            <section class="lobby-auth-panel panel-surface state-card" aria-live="polite">
                <span class="section-kicker">Wird geladen</span>
                <h2 class="panel-title">Gamesessions</h2>
                <p class="panel-subtitle">Authentifizierung wird geladen …</p>
            </section>
        }
        else if (!IsAuthenticated)
        {
            <section class="lobby-auth-panel panel-surface" aria-labelledby="auth-panel-title">
                <span class="section-kicker">Zugang</span>
                <h2 id="auth-panel-title" class="panel-title">Anmelden</h2>
                <p class="panel-subtitle">Sende dir einen Magic Link, um deine Gamesessions zu öffnen.</p>

                <form class="session-form auth-form"
                      @onsubmit="RequestMagicLink"
                      @onsubmit:preventDefault
                      aria-busy="@(_isSendingMagicLink ? "true" : "false")">
                    <label class="input-group" for="auth-email">
                        <span class="input-label">E-Mail</span>
                        <input id="auth-email"
                               class="session-input"
                               type="email"
                               @bind="_email"
                               @bind:event="oninput"
                               maxlength="320"
                               autocomplete="email"
                               placeholder="name@beispiel.de"
                               disabled="@_isSendingMagicLink"/>
                    </label>

                    <button type="submit"
                            class="session-btn primary-btn"
                            disabled="@IsMagicLinkRequestDisabled"
                            aria-busy="@(_isSendingMagicLink ? "true" : "false")">
                        @MagicLinkRequestButtonText
                    </button>
                </form>

                @if (IsMagicLinkCooldownActive)
                {
                    <div class="magic-link-cooldown" role="status">@MagicLinkCooldownText</div>
                }

                @if (!string.IsNullOrWhiteSpace(_authMessage))
                {
                    <div class="session-success" role="status">@_authMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="session-alert" role="alert">@_error</div>
                }
            </section>
        }
        else
        {
            <section id="session-board" class="session-board panel-surface" aria-labelledby="session-board-title">
                <div class="section-header board-header">
                    <div>
                        <h2 id="session-board-title" class="panel-title">Meine Sessions (@SessionCount)</h2>
                        <p class="panel-subtitle">Öffne eine Runde oder verwalte ihre Mitglieder und Aktionen in den Details.</p>
                    </div>
                    <a class="jump-link" href="#session-workbench">Session beitreten/erstellen</a>
                </div>

                @if (!SessionState.IsLoaded)
                {
                    <div class="state-card" aria-live="polite">
                        <span class="section-kicker">Wird geladen</span>
                        <p class="mode-text">Deine Sessions werden geladen …</p>
                    </div>
                }
                else
                {
                    <div class="board-body">
                        <SessionTree Sessions="SessionState.Sessions"
                                     ActiveSessionId="@SessionState.ActiveSessionId"
                                     EmptyText="Noch keine Sessions. Erstelle eine Session oder tritt einer bei."
                                     ShowCopyButton="true"/>
                    </div>
                }
            </section>

            <section id="session-workbench"
                     class="session-workbench panel-surface"
                     aria-labelledby="session-workbench-title"
                     aria-busy="@(_isSubmittingSession ? "true" : "false")">
                <div class="section-header">
                    <div>
                        <h2 id="session-workbench-title" class="panel-title">Beitreten / Erstellen</h2>
                        <p class="panel-subtitle">Der Name gilt für Beitreten und Erstellen. Bestehende Mitgliedschaften änderst du direkt in ihrer Session.</p>
                    </div>
                </div>

                <div class="mode-toggle" role="group" aria-label="Sessionaktion">
                    <button type="button"
                            class="mode-pill @GetModeClass(SessionMode.Join)"
                            aria-pressed="@(CurrentMode == SessionMode.Join ? "true" : "false")"
                            @onclick="() => SetMode(SessionMode.Join)"
                            disabled="@_isSubmittingSession">
                        Beitreten
                    </button>
                    <button type="button"
                            class="mode-pill @GetModeClass(SessionMode.Create)"
                            aria-pressed="@(CurrentMode == SessionMode.Create ? "true" : "false")"
                            @onclick="() => SetMode(SessionMode.Create)"
                            disabled="@_isSubmittingSession">
                        Erstellen
                    </button>
                </div>

                <label class="input-group" for="session-player-name">
                    <span class="input-label">Dein Name für diese Session</span>
                    <input id="session-player-name"
                           class="session-input"
                           value="@_userName"
                           @oninput="HandleUserNameInput"
                           maxlength="40"
                           autocomplete="nickname"
                           placeholder="Spielername eingeben"
                           disabled="@_isSubmittingSession"/>
                </label>
                <p class="field-hint">Dieser Name wird beim Beitreten oder Erstellen verwendet.</p>

                @if (CurrentMode == SessionMode.Join)
                {
                    <form id="session-join-form"
                          class="session-form mode-panel"
                          @onsubmit="Join"
                          @onsubmit:preventDefault
                          aria-labelledby="session-join-title"
                          aria-busy="@(_isSubmittingSession ? "true" : "false")">
                        <div>
                            <h3 id="session-join-title" class="mode-caption">Session beitreten</h3>
                            <p class="mode-text">Gib den Join-Code deiner Gruppe ein.</p>
                        </div>

                        <label class="input-group" for="session-join-code">
                            <span class="input-label">Session-Code</span>
                            <input id="session-join-code"
                                   class="session-input session-code-input"
                                   @bind="_joinCode"
                                   @bind:event="oninput"
                                   maxlength="8"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="z.B. X7K9"
                                   disabled="@_isSubmittingSession"/>
                        </label>

                        <button type="submit"
                                class="session-btn primary-btn"
                                disabled="@(!CanJoinSession)"
                                aria-busy="@(_isSubmittingSession ? "true" : "false")">
                            Sitzung Beitreten
                        </button>
                    </form>
                }
                else
                {
                    <form id="session-create-form"
                          class="session-form mode-panel"
                          @onsubmit="Create"
                          @onsubmit:preventDefault
                          aria-labelledby="session-create-title"
                          aria-busy="@(_isSubmittingSession ? "true" : "false")">
                        <div>
                            <h3 id="session-create-title" class="mode-caption">Neue Session erstellen</h3>
                            <p class="mode-text">Vergib optional einen Namen für deine neue Runde.</p>
                        </div>

                        <label class="input-group" for="session-name">
                            <span class="input-label">Session-Name</span>
                            <input id="session-name"
                                   class="session-input"
                                   @bind="_sessionName"
                                   @bind:event="oninput"
                                   maxlength="80"
                                   autocomplete="off"
                                   placeholder="z.B. Borbarads Erben"
                                   disabled="@_isSubmittingSession"/>
                        </label>

                        <button type="submit"
                                class="session-btn primary-btn"
                                disabled="@(!CanCreateSession)"
                                aria-busy="@(_isSubmittingSession ? "true" : "false")">
                            Session Erstellen
                        </button>
                    </form>
                }

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="session-alert" role="alert">@_error</div>
                }
            </section>
        }
    </div>
</div>
