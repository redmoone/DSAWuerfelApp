@page "/"

<div class="lobby-page">
    <div class="lobby-shell">
        <section class="lobby-hero panel-surface">
            <div class="hero-copy">
                <p class="hero-eyebrow">Gamesessions</p>
                <h1 class="hero-title">DSA Wuerfelrunde</h1>
                <p class="hero-description">
                    Starte eine neue Runde als Meister oder tritt mit einem Session-Code direkt deiner Gruppe bei.
                </p>
            </div>

            <div class="hero-pills">
                <div class="info-pill">Live Sitzungen</div>
                <div class="info-pill">Goldenes DSA Layout</div>
                <div class="info-pill">Direkt im Browser</div>
            </div>
        </section>

        <section class="lobby-panel panel-surface">
            <h2 class="panel-title">Session Eingang</h2>

            <label class="input-group">
                <span class="input-label">Dein Name</span>
                <input class="session-input"
                       @bind="_userName"
                       @bind:event="oninput"
                       maxlength="40"
                       autocomplete="nickname"
                       placeholder="Spielername eingeben"/>
            </label>

            <div class="mode-toggle" role="tablist" aria-label="Session Modus">
                <button type="button"
                        class="mode-pill @GetModeClass(SessionMode.Join)"
                        @onclick="() => SetMode(SessionMode.Join)">
                    Beitreten
                </button>
                <button type="button"
                        class="mode-pill @GetModeClass(SessionMode.Create)"
                        @onclick="() => SetMode(SessionMode.Create)">
                    Neue Runde
                </button>
            </div>

            @if (CurrentMode == SessionMode.Join)
            {
                <div class="mode-panel">
                    <p class="mode-text">Gib den Session-Code deiner Gruppe ein und verbinde dich direkt mit der
                        Runde.</p>

                    <label class="input-group">
                        <span class="input-label">Session Code</span>
                        <input class="session-input session-code-input"
                               @bind="_joinCode"
                               @bind:event="oninput"
                               maxlength="8"
                               autocomplete="off"
                               spellcheck="false"
                               placeholder="z.B. X7K9"/>
                    </label>

                    <button type="button"
                            class="session-btn"
                            @onclick="Join"
                            disabled="@string.IsNullOrWhiteSpace(_userName) || string.IsNullOrWhiteSpace(_joinCode)">
                        Sitzung Beitreten
                    </button>
                </div>
            }
            else
            {
                <div class="mode-panel">
                    <p class="mode-text">Erstelle eine neue Spielrunde. Du wirst sofort als erster Spieler
                        verbunden.</p>

                    <div class="create-callout">
                        <span class="callout-label">Hinweis</span>
                        <span class="callout-text">Der Session-Code wird nach dem Erstellen automatisch fuer deine Gruppe bereitgestellt.</span>
                    </div>

                    <button type="button"
                            class="session-btn"
                            @onclick="Create"
                            disabled="@string.IsNullOrWhiteSpace(_userName)">
                        Session Erstellen
                    </button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="session-alert">@_error</div>
            }
        </section>

        <aside class="lobby-side panel-surface">
            <h2 class="panel-title">Ablauf</h2>

            <ol class="steps-list">
                <li class="step-item">
                    <span class="step-index">1</span>
                    <div>
                        <strong>Name setzen</strong>
                        <p>Waehle zuerst den Spielernamen, unter dem deine Wuerfe erscheinen sollen.</p>
                    </div>
                </li>
                <li class="step-item">
                    <span class="step-index">2</span>
                    <div>
                        <strong>Modus waehlen</strong>
                        <p>Entweder einer vorhandenen Runde beitreten oder selbst eine Session starten.</p>
                    </div>
                </li>
                <li class="step-item">
                    <span class="step-index">3</span>
                    <div>
                        <strong>Loswuerfeln</strong>
                        <p>Nach dem Verbinden landest du direkt auf der Wuerfelseite deiner Gruppe.</p>
                    </div>
                </li>
            </ol>
        </aside>
    </div>
</div>
